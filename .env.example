DATABASE_URL="postgresql://USER@85.239.249.103:5432/russell?schema=public"
SESSION_SECRET="genera-uno-con: openssl rand -base64 32"

# IA — extracción asistida de balances (Claude). Sin esta clave, "Cargar balance"
# usa el parser de plantilla limpia como respaldo.
ANTHROPIC_API_KEY="sk-ant-..."
# Modelo opcional (por defecto claude-sonnet-4-6).
# ANTHROPIC_MODEL="claude-sonnet-4-6"
# TRM de respaldo (COP por 1 USD) para costear el consumo de IA cuando no se puede
# consultar la TRM oficial (datos.gov.co) ni hay una previa en la BD. Opcional
# (por defecto 4000). La TRM oficial se obtiene y cachea sola; esto es solo el fallback.
# USD_COP_TRM_FALLBACK="4000"

# Almacenamiento de objetos para fotos de perfil (S3 / MinIO / Cloudflare R2).
# Las fotos NUNCA se guardan en la base de datos: solo se persiste la `key` del
# objeto. Sin estas variables, la app sigue funcionando y los usuarios ven sus
# iniciales (la subida de fotos queda deshabilitada).
S3_BUCKET="russell-avatares"
S3_REGION="us-east-1"            # AWS: tu región. Cloudflare R2 usa "auto".
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
# Para MinIO o Cloudflare R2 (endpoint propio en vez de AWS):
# S3_ENDPOINT="https://minio.tu-dominio.com"   # o el endpoint de R2
# S3_FORCE_PATH_STYLE="true"                    # MinIO suele requerirlo

# Atributo Secure de la cookie de sesión.
# Sin definir: se sigue el protocolo real (x-forwarded-proto); por HTTP plano
# la cookie NO es Secure (necesario para que la sesión funcione sin TLS).
# Detrás de un proxy TLS puedes forzarlo con COOKIE_SECURE="true".
# COOKIE_SECURE="true"
