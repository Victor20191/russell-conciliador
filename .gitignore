# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# archivos de entorno locales: no subir a Git
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client
/src/generated/prisma
.smoke-*.png

# imágenes pegadas desde el portapapeles (no versionar)
clipboard-*.png

# hojas de cálculo, PDF, Word, scripts Python y texto
*.xlsx
*.xls
*.xlsm
*.xlsb
*.pdf
*.doc
*.docx
*.docm
*.py
*.txt

# Estado de dedupe del volcado de novedades (npm run novedades:commits)
.claude/novedades-state.json
