# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# archivos de entorno locales: no subir a Git
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client
/src/generated/prisma
.smoke-*.png

# imágenes pegadas desde el portapapeles (no versionar)
clipboard-*.png

# artefactos locales de Playwright MCP (snapshots .yml y capturas de depuración)
.playwright-mcp/
login-*.png
modulos-inv-*.png

# hojas de cálculo, PDF, Word, scripts Python y texto
*.xlsx
*.xls
*.xlsm
*.xlsb
*.pdf
*.doc
*.docx
*.docm
*.py
*.txt

# Estado de dedupe del volcado de novedades (npm run novedades:commits)
.claude/novedades-state.json

# Salida y artefactos locales de graphify (grafo de conocimiento; no versionar)
graphify-out/
.graphify*

# El subagente de evolución sí pertenece al proyecto; el estado local anterior
# permanece ignorado y no se versiona.
!.claude/
.claude/*
!.claude/agents/
!.claude/agents/russell-lfm-evolucion.md

# snapshots de reversión de scripts/rehomologar-fuera-de-clase.ts (datos de producción)
scripts/.snapshots/

# Datos de clientes y scripts temporales locales (no versionar)
/outputs/
/_tmp_*

# PDF, texto e imágenes: nunca se versionan (capturas, manuales, muestras).
# Variantes en mayúsculas porque el VPS (Linux) distingue mayúsculas.
*.[pP][dD][fF]
*.[tT][xX][tT]
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[gG][iI][fF]
*.[wW][eE][bB][pP]
*.[bB][mM][pP]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[hH][eE][iI][cC]
*.[aA][vV][iI][fF]
*.[sS][vV][gG]
*.[iI][cC][oO]
# Excepciones: los íconos y estáticos que sirve la app sí se versionan.
!/public/**
!/src/app/favicon.ico
!/src/app/**/icon.*
!/src/app/**/apple-icon.*
!/src/app/**/opengraph-image.*
