// Schema Prisma 7 — Russell Bedford · Conciliador/Diagnóstico
// Modelos derivados de los datos demo del prototipo original (data*.jsx)
//
// Convención: la base de datos física está en ESPAÑOL.
//   - Tablas: @@map("nombre_en_espanol")
//   - Columnas: @map("columna_en_espanol")  (snake_case)
// Los identificadores del modelo Prisma se mantienen para no romper el código,
// pero el objeto real en PostgreSQL siempre queda en español.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== Autenticación =====
model User {
  id                  Int              @id @default(autoincrement()) @map("id")
  email               String           @unique @map("correo")
  password            String           @map("contrasena") // hash bcrypt
  name                String           @map("nombre")
  cedula              String?          @unique @map("cedula") // documento de identidad (único)
  cargo               String?          @map("cargo") // título de puesto (texto libre)
  role                String           @default("Consulta") @map("rol")
  initials            String           @map("iniciales")
  // Referencia (key) a la foto de perfil en el almacenamiento de objetos
  // (S3/MinIO/R2). El binario NUNCA vive en la BD: aquí solo va la clave.
  avatarKey           String?          @map("clave_foto")
  active              Boolean          @default(true) @map("activo")
  sessionVersion      Int              @default(0) @map("version_sesion")
  failedLoginAttempts Int              @default(0) @map("intentos_fallidos")
  lastFailedLoginAt   DateTime?        @map("ultimo_intento_fallido") @db.Timestamptz(3)
  blockedUntil        DateTime?        @map("bloqueado_hasta") @db.Timestamptz(3)
  mustChangePassword  Boolean          @default(false) @map("debe_cambiar_contrasena")
  lastLoginAt         DateTime?        @map("ultimo_inicio_sesion") @db.Timestamptz(3)
  comments            Comment[]        @relation("ComentariosAutor")
  mentions            CommentMention[] @relation("MencionesUsuario")
  createdAt           DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@map("usuarios")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement()) @map("id")
  email     String   @map("correo")
  ip        String   @map("ip")
  success   Boolean  @map("exitoso")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("intentos_inicio_sesion")
}

// ============================================================
// ===== Control de acceso y organización · Roles, permisos,
//       jerarquía organizacional y responsables por cliente =====
//
// Parametrización derivada de "RB_GCT Roles y Responsabilidades –
// Área de Revisoría Fiscal" (Russell Bedford, 04-jun-2026).
//
// El bloque nació en la migración aditiva
// 20260605235129_rbac_control_acceso. La migración posterior de IDs
// convirtió también sus claves y referencias a INTEGER. La migración
// asignacion_directa_y_jerarquia reemplazó equipos/cartera manual por
// jerarquia_usuarios + responsables directos por cliente.
//
// Convención del repo (OBLIGATORIA):
//   - Identificadores Prisma en inglés; tablas/columnas físicas en
//     ESPAÑOL snake_case vía @@map / @map.
//   - Todos los modelos usan id numérico autoincremental. Los códigos de
//     negocio (C-1042, INV, IVA...) se conservan como columnas únicas.
//   - FK SUAVES hacia User y Client: solo el id Int mapeado, SIN
//     @relation (relación lógica sin FK física). Así no se agregan
//     relaciones inversas en User/Client.
//   - Coexiste con usuarios.rol:String @default("Consulta") y can()
//     (src/lib/roles.ts). usuarios.rol se reinterpreta como FK
//     LÓGICA a Role.code (mismo valor), sin migrar esa columna todavía.
//
// NOTA sobre la jerarquía: el PDF separa jerarquía organizacional
// de capacidad operativa. Socio/Gerente/Senior tienen rango alto
// pero son de CONSULTA; el Staff es el ÚNICO que escribe pese a su
// rango bajo. Un can() puramente jerárquico NO captura esto: la
// verdad operativa vive en la matriz RolePermission (y, por
// conveniencia, en Role.isOperative). Role.rank se conserva solo
// para alimentar can()/ROLE_RANK durante la transición.
// ============================================================

/// Catálogo de ROLES (los 5 del PDF + roles legado para no dejar
/// usuarios huérfanos). Editable por el Administrador sin desplegar
/// código. `code` es la llave natural en español que vive en
/// usuarios.rol, reinterpretada como FK lógica.
model Role {
  id          Int              @id @default(autoincrement()) @map("id")
  code        String           @unique @map("codigo") // socio | gerente | senior | staff | administrador (+ legado: Consulta/Auditor/Líder)
  name        String           @map("nombre") // etiqueta visible: "Socio", "Senior"...
  description String?          @map("descripcion") // responsabilidad según el PDF
  rank        Int              @default(0) @map("rango") // jerarquía: alimenta ROLE_RANK/can() durante la transición
  isOperative Boolean          @default(false) @map("es_operativo") // true SOLO para Staff (único que escribe/ejecuta)
  isSystem    Boolean          @default(false) @map("es_sistema") // roles base no borrables desde la UI
  active      Boolean          @default(true) @map("activo")
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([rank])
  @@map("roles")
}

/// Catálogo de PERMISOS atómicos. `code` es la llave canónica
/// "<modulo>:<accion>" usada por los gates en código (p.ej.
/// "conciliaciones:ejecutar", "clientes:configurar"). Las columnas
/// module/action/label permiten al Administrador entender y filtrar
/// la matriz en una futura UI.
model Permission {
  id          Int              @id @default(autoincrement()) @map("id")
  code        String           @unique @map("codigo") // <modulo>:<accion>
  module      String           @map("modulo") // conciliaciones | balance | dian | clientes | usuarios | equipos | auditoria...
  action      String           @map("accion") // ver | crear | editar | eliminar | ejecutar | revisar | supervisar | asignar | configurar
  label       String           @map("etiqueta") // texto legible para la matriz del Administrador
  description String?          @map("descripcion")
  active      Boolean          @default(true) @map("activo")
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@unique([module, action])
  @@index([module])
  @@map("permisos")
}

/// MATRIZ rol × permiso (concesión). La tabla que el Administrador
/// edita para conceder/revocar permisos sin desplegar código.
/// Fila presente = permiso concedido (sin flag de denegación).
model RolePermission {
  id           Int        @id @default(autoincrement()) @map("id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       Int        @map("rol_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId Int        @map("permiso_id")
  createdAt    DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("roles_permisos")
}

/// JERARQUÍA organizacional usuario↔usuario (muchos a muchos).
/// Aristas entre roles ADYACENTES: Socio→Gerente, Gerente→Senior,
/// Senior→Staff. Un staff puede reportar a varios seniors, un senior
/// a varios gerentes, etc. La adyacencia de roles se valida en la
/// server action (src/app/actions/users.ts), no en BD.
/// superiorId y subordinateId son FK SUAVES a User.id (sin @relation);
/// la limpieza al borrar usuarios es manual (deleteUser).
model UserHierarchy {
  id            Int      @id @default(autoincrement()) @map("id")
  superiorId    Int      @map("superior_id") // FK lógica a User.id
  subordinateId Int      @map("subordinado_id") // FK lógica a User.id
  createdAt     DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@unique([superiorId, subordinateId])
  @@index([subordinateId])
  @@map("jerarquia_usuarios")
}

/// RESPONSABLES del cliente — asignación DIRECTA (sin equipos), hecha
/// al crear/editar el cliente. Un cliente admite UNO O VARIOS staff y
/// EXACTAMENTE un senior y un gerente:
///   staff   → ejecuta la auditoría (readScope + writeScope) · uno o varios
///   senior  → revisa               (readScope) · uno
///   gerente → valida               (readScope) · uno
/// El Socio NO se asigna: deriva LECTURA por jerarquía
/// (jerarquia_usuarios) sobre los clientes donde sus gerentes
/// subordinados tengan funcion="gerente" vigente.
///
/// Vigencia temporal: validFrom/validUntil delimitan la ventana en la
/// que la asignación AUTORIZA (se filtra por fecha al leer en
/// getAsignacionesUsuario, sin jobs).
///
/// clientId, userId y assignedById son FK SUAVES numéricas (a
/// Client.id y User.id).
model ClientAssignment {
  id           Int       @id @default(autoincrement()) @map("id")
  clientId     Int       @map("cliente_id") // FK lógica a Client.id
  userId       Int       @map("usuario_id") // responsable (FK lógica a User.id)
  role         String    @map("funcion") // staff | senior | gerente
  readScope    Boolean   @default(true) @map("alcance_lectura") // ve este cliente
  writeScope   Boolean   @default(false) @map("alcance_escritura") // escribe/ejecuta (solo staff)
  assignedById Int?      @map("asignado_por_id") // quién asignó (FK lógica a User.id)
  active       Boolean   @default(true) @map("activo")
  validFrom    DateTime  @default(now()) @map("vigente_desde") @db.Timestamptz(3) // inicio de vigencia
  validUntil   DateTime? @map("vigente_hasta") @db.Timestamptz(3) // fin de vigencia; null = permanente
  reason       String?   @map("motivo") // p.ej. "asignación temporal"
  createdAt    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  // (cliente, función, usuario): un cliente admite VARIOS staff distintos,
  // sin poder duplicar a la misma persona en la misma función. La regla de
  // "un solo senior y un solo gerente" se garantiza en la Server Action.
  @@unique([clientId, role, userId])
  @@index([clientId])
  @@index([userId, active, validUntil])
  @@map("asignaciones_cliente")
}

// ===== Clientes y módulos =====
model Client {
  id              Int              @id @default(autoincrement()) @map("id")
  code            String           @unique @map("codigo") // p.ej. C-1042
  name            String           @map("nombre")
  nit             String           @unique @map("nit")
  tipo            String           @default("C") @map("tipo_cliente") // clasificación A | B | C
  erp             Erp?             @relation(fields: [erpId], references: [id], onDelete: Restrict)
  erpId           Int?             @map("erp_id") // FK al catálogo erps (opcional: se exige al INICIAR una operación, no al cargar)
  sector          Sector?          @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  sectorId        Int?             @map("sector_id") // FK al catálogo sectores (opcional: hay clientes sin sector)
  socioId         Int?             @map("socio_id") // socio responsable (FK lógica a User.id, informativo)
  modules         ClientModule[]
  dianForms       ClientDianForm[]
  reconciliations Reconciliation[]
  createdAt       DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([socioId])
  @@index([erpId])
  @@index([sectorId])
  @@map("clientes")
}

// ===== Catálogos maestros: ERP y Sector (Config · Clientes) =====
/// Catálogo de sistemas contables/ERP que usan los clientes (SIESA, SIIGO,
/// SAP…). `code` es la forma canónica en MAYÚSCULAS sin acentos; `name` la
/// etiqueta visible. Antes era texto libre en clientes.erp.
model Erp {
  id        Int      @id @default(autoincrement()) @map("id")
  code      String   @unique @map("codigo") // forma canónica: SIESA, SAP, SIIGO, OFIMATICA...
  name      String   @map("nombre") // etiqueta visible
  active    Boolean  @default(true) @map("activo")
  order     Int      @default(0) @map("orden")
  clients   Client[]
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@map("erps")
}

/// Catálogo de sectores económicos del cliente. El origen trae "N-Nombre"
/// (p.ej. "15-ESAL"): `code` guarda el número ("15") y `name` la etiqueta
/// ("ESAL"). Antes era texto libre en clientes.sector.
model Sector {
  id        Int      @id @default(autoincrement()) @map("id")
  code      String   @unique @map("codigo") // número del sector: "5", "15"...
  name      String   @map("nombre") // etiqueta: "Comercio y Distribución", "ESAL"...
  active    Boolean  @default(true) @map("activo")
  order     Int      @default(0) @map("orden")
  clients   Client[]
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@map("sectores")
}

model Module {
  id                  Int                  @id @default(autoincrement()) @map("id")
  code                String               @unique @map("codigo") // INV, CAR, NOM...
  name                String               @map("nombre")
  icon                String               @map("icono")
  clients             ClientModule[]
  fields              ModuleField[]
  prevalidadorCuentas PrevalidadorCuenta[]

  @@map("modulos")
}

// ===== Campos estándar por módulo (Config · Módulos y campos) =====
model ModuleField {
  id       Int     @id @default(autoincrement()) @map("id")
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId Int     @map("modulo_id")
  key      String  @map("clave") // clave técnica: cuenta, codigo_item...
  label    String  @map("etiqueta")
  type     String  @map("tipo") // string | number | date
  required Boolean @default(false) @map("requerido")
  hint     String? @map("ayuda")
  order    Int     @default(0) @map("orden")

  @@unique([moduleId, key])
  @@map("campos_modulo")
}

model ClientModule {
  id       Int    @id @default(autoincrement()) @map("id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int    @map("cliente_id")
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId Int    @map("modulo_id")
  status   String @map("estado") // configured | pending

  @@unique([clientId, moduleId])
  @@map("modulos_cliente")
}

// ===== Formularios DIAN activados por cliente (Config · Clientes) =====
/// Qué formatos DIAN (IVA F-300, Retención F-350, ICA F-CHIP…) aplican a cada
/// cliente. Se eligen en la sección "Módulos del cliente" al crear/editar el
/// cliente: activar DIAN equivale a tener al menos un formato seleccionado.
model ClientDianForm {
  id        Int      @id @default(autoincrement()) @map("id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  Int      @map("cliente_id")
  form      DianForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    Int      @map("formulario_id")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@unique([clientId, formId])
  @@map("formularios_dian_cliente")
}

// ===== Superadministración · publicación visual de módulos =====
/// Catálogo de módulos funcionales de la plataforma. Controla si un
/// módulo se publica para usuarios NO superadministradores. No concede permisos:
/// la autorización final sigue siendo la matriz RolePermission.
model PlatformModule {
  id                       Int      @id @default(autoincrement()) @map("id")
  key                      String   @unique @map("clave") // balance | dian | conciliaciones...
  label                    String   @map("etiqueta")
  description              String?  @map("descripcion")
  group                    String   @map("grupo") // Trabajo | Configuración
  icon                     String   @map("icono")
  order                    Int      @default(0) @map("orden")
  enabledForNonAdmins      Boolean  @default(true) @map("habilitado_no_administradores")
  configurableForNonAdmins Boolean  @default(true) @map("bloqueable_no_administradores")
  createdAt                DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([group, order])
  @@map("modulos_plataforma")
}

// ===== Conciliaciones =====
model Reconciliation {
  id                   Int                      @id @default(autoincrement()) @map("id")
  code                 String                   @unique @map("codigo") // REC-2026-0418
  client               Client?                  @relation(fields: [clientId], references: [id])
  clientId             Int?                     @map("cliente_id")
  clientName           String                   @map("nombre_cliente")
  module               String                   @map("modulo")
  period               String                   @map("periodo")
  erp                  String                   @map("erp")
  status               String                   @map("estado") // OK | DIFF | REVIEW
  diff                 String                   @map("diferencia")
  items                Int                      @default(0) @map("items")
  owner                String                   @map("responsable")
  cutoff               DateTime?                @map("corte") @db.Date
  runAt                DateTime?                @map("ejecutado_en") @db.Timestamptz(3)
  runBy                String?                  @map("ejecutado_por")
  lastActivity         DateTime?                @map("ultima_actividad") @db.Timestamptz(3)
  materiality          Int                      @default(2000000) @map("materialidad")
  // Balance cuya aprobación del prevalidador habilitó esta conciliación. La
  // compuerta lo llena al crearla; Restrict conserva la evidencia e impide
  // eliminar un balance que ya habilitó una conciliación.
  balancePrevalidado   BalancePruebaEncabezado? @relation(fields: [balancePrevalidadoId], references: [id], onDelete: Restrict)
  balancePrevalidadoId Int?                     @map("balance_prevalidado_id")
  rows                 ReconciliationRow[]
  comments             ReconciliationComment[]
  createdAt            DateTime                 @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([clientId, createdAt], map: "conciliaciones_cliente_creado_en_idx")
  @@index([balancePrevalidadoId])
  @@index([createdAt])
  @@map("conciliaciones")
}

model ReconciliationRow {
  id               Int            @id @default(autoincrement()) @map("id")
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  reconciliationId Int            @map("conciliacion_id")
  cuenta           String         @map("cuenta")
  desc             String         @map("descripcion")
  cont             Int            @map("saldo_contabilidad") // saldo contabilidad
  mod              Int            @map("saldo_modulo") // saldo módulo
  diff             Int            @map("diferencia")
  items            Int            @default(0) @map("items")
  manualStatus     String?        @map("estado_manual") // conciliada | excepcion | ajuste (override del estado por materialidad)
  order            Int            @default(0) @map("orden")

  @@index([reconciliationId])
  @@map("filas_conciliacion")
}

model ReconciliationComment {
  id               Int            @id @default(autoincrement()) @map("id")
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  reconciliationId Int            @map("conciliacion_id")
  cuenta           String         @map("cuenta")
  who              String         @map("autor")
  initials         String         @map("iniciales")
  text             String         @map("texto")
  createdAt        DateTime       @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@map("comentarios_conciliacion")
}

// ===== Notificaciones =====
model Notification {
  id        Int      @id @default(autoincrement()) @map("id")
  kind      String   @map("tipo") // assign | comment | system
  who       String   @map("autor")
  text      String   @map("texto")
  target    String   @map("destino")
  unread    Boolean  @default(true) @map("no_leida")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@map("notificaciones")
}

// ===== Conversaciones (comentarios polimórficos + menciones) =====

/// Comentario de una CONVERSACIÓN anclada de forma POLIMÓRFICA a
/// cualquier registro de negocio mediante (entidad_tipo, entidad_id).
/// `entidad_tipo` reutiliza los códigos de módulo del RBAC
/// (conciliaciones | dian | clientes | balance…), de
/// modo que el mismo código identifica el módulo del permiso, el ítem
/// de navegación y la entidad conversable. `ancla` ubica el comentario
/// dentro del registro cuando aplica (p.ej. la cuenta en una
/// conciliación o el renglón en un formulario DIAN).
model Comment {
  id           Int                @id @default(autoincrement()) @map("id")
  entityType   String             @map("entidad_tipo")
  entityId     Int                @map("entidad_id")
  anchor       String?            @map("ancla")
  author       User               @relation("ComentariosAutor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId     Int                @map("autor_id")
  body         String             @map("texto")
  parent       Comment?           @relation("ComentarioHilo", fields: [parentId], references: [id], onDelete: Cascade)
  parentId     Int?               @map("comentario_padre_id")
  replies      Comment[]          @relation("ComentarioHilo")
  isAI         Boolean            @default(false) @map("es_ia")
  editedAt     DateTime?          @map("editado_en") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("creado_en") @db.Timestamptz(3)
  mentions     CommentMention[]
  validaciones ValidacionAlerta[]

  @@index([entityType, entityId])
  @@index([authorId])
  @@map("comentarios")
}

/// Validación (OK) de una alerta de naturaleza/saldo contrario en una cuenta de un
/// balance. Requiere un comentario justificativo (queda en la conversación de la
/// cuenta) y retira la alerta de la vista. Reversible. FK suave a User; FK dura al
/// comentario (si se borra el comentario, cae la validación).
model ValidacionAlerta {
  id            Int      @id @default(autoincrement()) @map("id")
  balanceId     Int      @map("balance_id") // FK suave → balance_prueba_encabezado
  anchor        String   @map("ancla") // código de cuenta (nodo.code)
  tipoAlerta    String   @map("tipo_alerta") // "naturaleza" | "saldo_contrario"
  comment       Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId     Int      @map("comentario_id")
  validadoPor   String?  @map("validado_por")
  validadoPorId Int?     @map("validado_por_id") // FK suave → User
  validadoEn    DateTime @default(now()) @map("validado_en") @db.Timestamptz(3)

  @@unique([balanceId, anchor])
  @@index([balanceId])
  @@map("validacion_alerta")
}

/// Mención (@usuario) dentro de un comentario. Tabla propia para poder
/// consultar "mis menciones", marcarlas leídas y disparar la
/// notificación al usuario arrobado.
model CommentMention {
  id        Int       @id @default(autoincrement()) @map("id")
  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int       @map("comentario_id")
  user      User      @relation("MencionesUsuario", fields: [userId], references: [id], onDelete: Cascade)
  userId    Int       @map("usuario_mencionado_id")
  readAt    DateTime? @map("leido_en") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("menciones_comentario")
}

// ===== Auditoría =====
model AuditEntry {
  id        Int      @id @default(autoincrement()) @map("id")
  user      String   @map("usuario")
  action    String   @map("accion")
  entity    String   @map("entidad")
  detail    String   @map("detalle")
  // FK suave al cliente afectado. Permite filtrar la bitácora por cartera sin
  // inferir la empresa a partir de textos libres.
  clientId  Int?     @map("cliente_id")
  ip        String?  @map("ip")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([clientId, createdAt])
  @@map("registros_auditoria")
}

// ===== Accesos / navegación (analítica de tráfico) =====
// Capa separada de `AuditEntry`: aquí se registra QUÉ rutas visita cada usuario
// y cuándo (incluidos ingreso/cierre de sesión), para la analítica de tráfico.
// `userName`/`role` van denormalizados para que el histórico sobreviva al borrado
// del usuario (FK suave: solo `userId` Int, sin @relation, sin cascada).
model AccessLog {
  id        Int      @id @default(autoincrement()) @map("id")
  userId    Int?     @map("usuario_id")
  userName  String   @map("usuario")
  role      String?  @map("rol")
  path      String   @map("ruta")
  kind      String   @map("tipo") // navegacion | ingreso | salida
  ip        String?  @map("ip")
  userAgent String?  @map("agente")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  // Índices alineados a las consultas del tablero y a la retención:
  //  - createdAt: detalle (orden + rango) y purga por antigüedad.
  //  - (kind, createdAt): ranking de rutas (kind='navegacion') y conteo por tipo.
  //  - (userName, createdAt): filtros/rankings acotados a un usuario.
  // Se evitan índices de una sola columna redundantes para no encarecer el INSERT
  // (tabla de alta escritura, lectura ocasional).
  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([userName, createdAt])
  @@map("registros_acceso")
}

// ===== Plan de cuentas estándar (Balance) =====
model StandardAccount {
  id                  Int     @id @default(autoincrement()) @map("id")
  code                String  @unique @map("codigo")
  name                String  @map("nombre")
  level               Int     @map("nivel")
  nature              String  @map("naturaleza") // D | C
  parent              String? @map("padre")
  critical            Boolean @default(false) @map("critica")
  russellAccount      String? @map("cuenta_russell")
  categoryType        String? @map("tipo_rubro")
  includes            String? @map("incluye")
  excludes            String? @map("no_incluye")
  possibleAccounts    String? @map("cuentas_posibles")
  supportingDocuments String? @map("soportes_terceros")
  controlSupports     String? @map("soportes_control")
  mappingNotes        String? @map("observaciones_homologacion")

  @@map("cuentas_estandar")
}

// ===== Subgrupos del plan estándar (nivel 4) =====
// Catálogo de subgrupos de 4 dígitos del plan Russell: aporta el NOMBRE de los
// niveles 4 y 2 para la vista jerárquica del balance (clase 2 → subgrupo 4 →
// cuenta estándar 6 → cuenta cliente 8). El enlace con `cuentas_estandar` es por
// prefijo del código (no hay FK física). Se carga desde
// `prisma/data/subgrupos-russell.json` con `npm run db:load:subgrupos`.
model SubgrupoEstandar {
  id          Int    @id @default(autoincrement()) @map("id")
  codigo      String @unique @map("codigo") // 4 dígitos (p. ej. 1105)
  nombre      String @map("nombre") // nombre del subgrupo (p. ej. Caja)
  grupo       String @map("grupo") // 2 dígitos (p. ej. 11)
  nombreGrupo String @map("nombre_grupo") // nombre del grupo (p. ej. Disponible)
  naturaleza  String @map("naturaleza") // D | C

  @@index([grupo])
  @@map("subgrupos_estandar")
}

// ===== Bitácora del plan de cuentas estándar =====
// Registro DEDICADO de todos los movimientos (crear/editar/eliminar) sobre las
// cuentas estándar de Russell, para evidenciar la trazabilidad completa de la
// parametrización del plan. Solo el Administrador opera esa tabla y cada cambio
// deja una fila aquí (además del registro global en `AuditEntry`).
// FK LÓGICAS (solo Int, sin @relation) hacia User y StandardAccount: la
// bitácora se CONSERVA aunque luego se borre la cuenta o el usuario; `code`
// preserva la referencia legible cuando `accountId` ya no existe.
model StandardAccountLog {
  id        Int      @id @default(autoincrement()) @map("id")
  accountId Int?     @map("cuenta_id") // id de la cuenta afectada (null tras borrado físico)
  code      String   @map("codigo") // código del sistema afectado (preserva referencia)
  action    String   @map("accion") // CREÓ | EDITÓ | ELIMINÓ
  user      String   @map("usuario") // nombre del actor
  userId    Int?     @map("usuario_id") // FK lógica al User
  detail    String   @map("detalle") // resumen legible del cambio
  before    Json?    @map("antes") // snapshot previo (campos)
  after     Json?    @map("despues") // snapshot nuevo (campos)
  ip        String?  @map("ip")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([accountId])
  @@index([createdAt])
  @@map("bitacora_cuentas_estandar")
}

// ===== Balance de comprobación =====
// DEPRECADO: modelo legado basado en JSON (`desglose`, `sumas`, etc.). Sustituido
// por el modelo normalizado `BalancePruebaEncabezado` + `BalancePruebaDetalle`.
// Se conserva la tabla (vacía) por compatibilidad; ya no se lee ni escribe.
model Balance {
  id              Int       @id @default(autoincrement()) @map("id")
  clientName      String    @map("nombre_cliente")
  clientNit       String?   @map("nit_cliente")
  period          String    @map("periodo")
  version         String    @map("version")
  isOfficial      Boolean   @default(false) @map("es_oficial")
  isFrozen        Boolean   @default(false) @map("esta_congelado")
  status          String    @default("Única") @map("estado")
  complete        Int       @default(100) @map("completitud")
  sums            Json?     @map("sumas") // activo, pasivo, patrimonio, ingresos, gastos, costos, utilidad
  validations     Json?     @map("validaciones") // reglas de validación
  breakdown       Json?     @map("desglose") // desglose por nivel 2 con items
  meta            Json?     @map("metadatos") // metadatos del cargue (file, rows, accounts...)
  versionHistory  Json?     @map("historial_versiones") // historial de versiones (v3/v2/v1) con metadatos
  diff            Json?     @map("comparativo") // comparativo de la versión oficial vs. la anterior
  auditLog        Json?     @map("bitacora") // bitácora de cargues/congelados por cliente
  incomeStatement Json?     @map("estado_resultado") // líneas del estado de resultado (concepto, 2025, 2024, presupuesto)
  lastUpload      DateTime? @map("ultima_carga") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@unique([clientName, period, version])
  @@map("balances")
}

// ===== Balance de prueba normalizado (encabezado + detalle) =====
// Modelo relacional del balance de comprobación del cliente. El ENCABEZADO es un
// cargue por (cliente, período, versión); el DETALLE es una fila por cuenta, con
// la cuenta desagregada por nivel PUC (2/4/6/8) y los montos como columnas reales
// (`saldo_inicial`, `debitos`, `creditos`, `saldo_final`) consultables vía SQL.
// Los agregados (sumas, validaciones, desglose, comparativo) se RECALCULAN desde
// el detalle al leer (ver `src/lib/balance/calcular.ts`), no se persisten.
model BalancePruebaEncabezado {
  id                       Int       @id @default(autoincrement()) @map("id")
  // Idempotencia de la promoción: identifica el lote de borrador que originó
  // este balance. Los registros históricos quedan en null; toda promoción nueva
  // lo persiste y la restricción única impide crear otra versión desde el mismo lote.
  loteId                   String?   @unique @map("lote_id")
  // FK LÓGICA a Client (solo Int, sin @relation): convención del proyecto para
  // FKs suaves hacia Client/User. `nombreCliente`/`nit` quedan denormalizados
  // para listar sin join.
  clienteId                Int       @map("cliente_id")
  nombreCliente            String    @map("nombre_cliente")
  nit                      String?   @map("nit")
  periodo                  String    @map("periodo") // display, p. ej. "Enero 2026"
  periodoInicio            DateTime  @map("periodo_inicio") @db.Date
  periodoFin               DateTime  @map("periodo_fin") @db.Date
  // Versionado (un oficial por cliente/período; congelado bloquea edición).
  version                  String    @map("version")
  esOficial                Boolean   @default(false) @map("es_oficial")
  estaCongelado            Boolean   @default(false) @map("esta_congelado")
  estado                   String    @default("Única") @map("estado")
  completitud              Int       @default(100) @map("completitud")
  // Resumen del cargue (para listados, ficha de versión y bitácora sin recalcular).
  archivo                  String?   @map("archivo")
  tamanoArchivo            String?   @map("tamano_archivo")
  cargadoPor               String?   @map("cargado_por")
  rolCarga                 String?   @map("rol_carga")
  cuadrado                 Boolean   @default(true) @map("cuadrado")
  // Nota AUTOMÁTICA del sistema («Sin alertas» / «N validación(es) con alerta»).
  // Siempre la escribe el cargue: no la pisa el comentario del revisor.
  nota                     String?   @map("nota")
  // Nota aclaratoria que escribe el revisor al promover el borrador (advertencia
  // del archivo fuente o nota voluntaria). Autor/fecha del cargue
  // = `cargadoPor`/`rolCarga`/`ultimaCarga`. Los dos campos siguientes distinguen
  // de forma durable la advertencia obligatoria de una nota voluntaria y conservan
  // la diferencia que ya no puede reconstruirse después de purgar el staging.
  comentarioAprobacion     String?   @map("comentario_aprobacion")
  advertenciaArchivoFuente Boolean   @default(false) @map("advertencia_archivo_fuente")
  diferenciaArchivoFuente  Decimal?  @map("diferencia_archivo_fuente") @db.Decimal(18, 2)
  // Constancia ESTRUCTURADA de las reubicaciones entre clases contables que se
  // aprobaron en el borrador (`RevisionReubicacionBalance[]`). Se guarda tal cual
  // para que el balance oficial muestre la MISMA ficha que mostró el borrador
  // (cuenta, clases origen/destino, saldo, justificación, revisor y fecha) sin
  // depender del staging, que se purga al confirmar. null = no hubo ninguna.
  reubicacionesAprobadas   Json?     @map("reubicaciones_aprobadas")
  sumaActivo               Decimal   @default(0) @map("suma_activo") @db.Decimal(18, 2)
  filasTotales             Int       @default(0) @map("filas_totales")
  mapeadas                 Int       @default(0) @map("mapeadas")
  sinMapear                Int       @default(0) @map("sin_mapear")
  criticas                 Int       @default(0) @map("criticas")
  cambios                  Int       @default(0) @map("cambios")
  // Metadatos del ETL.
  estandar                 String?   @map("estandar")
  convencionCredito        String?   @map("convencion_credito")
  // APERTURA del informe que se cargó, DECLARADA por el analista en el borrador
  // (obligatoria para promover): `cuenta` | `tercero`. Se copia del lote al
  // confirmar. Solo trazabilidad: no altera el cálculo. null = cargue anterior
  // a este dato (las pantallas muestran «—»). Ver `lib/balance/apertura-balance.ts`.
  aperturaBalance          String?   @map("apertura_balance")
  filasLeidas              Int?      @map("filas_leidas")
  filasExcluidas           Int?      @map("filas_excluidas")
  filasDescuadre           Int?      @map("filas_descuadre")
  congeladoPor             String?   @map("congelado_por")
  congeladoEn              DateTime? @map("congelado_en") @db.Timestamptz(3)
  ultimaCarga              DateTime? @map("ultima_carga") @db.Timestamptz(3)
  creadoEn                 DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  detalles                   BalancePruebaDetalle[]
  prevalidadorOverrides      PrevalidadorCuentaBalance[]
  prevalidadorRevisiones     PrevalidadorRevisionBalance[]
  conciliacionesPrevalidadas Reconciliation[]

  @@unique([clienteId, periodo, version])
  @@index([clienteId, periodo])
  @@index([nombreCliente])
  @@map("balance_prueba_encabezado")
}

model BalancePruebaDetalle {
  id             Int                     @id @default(autoincrement()) @map("id")
  encabezadoId   Int                     @map("encabezado_id")
  encabezado     BalancePruebaEncabezado @relation(fields: [encabezadoId], references: [id], onDelete: Cascade)
  // Cuenta desagregada por nivel PUC (prefijos del código imputable).
  cuenta2        String                  @map("cuenta_2") // 11
  cuenta4        String                  @map("cuenta_4") // 1110
  cuenta6        String                  @map("cuenta_6") // 111005
  cuenta8        String                  @map("cuenta_8") // 11100501 (código imputable completo)
  nombreCuenta   String                  @map("nombre_cuenta")
  // Mapeo al plan estándar Russell (cuenta de 6 dígitos) + % de coincidencia.
  cuenta6Russell String?                 @map("cuenta_6_russell")
  coincidencia   Decimal?                @map("porcentaje_coincidencia") @db.Decimal(5, 2)
  // Montos del balance de comprobación (firmados: débito +, crédito −).
  saldoInicial   Decimal                 @default(0) @map("saldo_inicial") @db.Decimal(18, 2)
  debitos        Decimal                 @default(0) @map("debitos") @db.Decimal(18, 2)
  creditos       Decimal                 @default(0) @map("creditos") @db.Decimal(18, 2)
  saldoFinal     Decimal                 @default(0) @map("saldo_final") @db.Decimal(18, 2)
  creadoEn       DateTime                @default(now()) @map("creado_en") @db.Timestamptz(3) // TS CREA
  editadoEn      DateTime                @updatedAt @map("editado_en") @db.Timestamptz(3) // TS EDICIÓN

  @@index([encabezadoId])
  @@index([cuenta6])
  @@index([cuenta6Russell])
  @@map("balance_prueba_detalle")
}

// Archivo temporal fragmentado para cargas de balance. Los bytes llegan en
// partes pequeñas para no atravesar el límite de payload de una sola Function;
// la Server Action los consume y elimina antes de iniciar la extracción.
model BalanceArchivoTemporal {
  loteId        String                        @id @map("lote_id")
  usuarioId     Int                           @map("usuario_id") // FK suave a usuarios
  nombreArchivo String                        @map("nombre_archivo")
  tipoContenido String                        @map("tipo_contenido")
  tamanoBytes   Int                           @map("tamano_bytes")
  tamanoParte   Int                           @map("tamano_parte")
  totalPartes   Int                           @map("total_partes")
  completado    Boolean                       @default(false) @map("completado")
  expiraEn      DateTime                      @map("expira_en") @db.Timestamptz(3)
  creadoEn      DateTime                      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime                      @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  partes        BalanceArchivoTemporalParte[]

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("balance_archivo_temporal")
}

model BalanceArchivoTemporalParte {
  id          BigInt                 @id @default(autoincrement()) @map("id")
  loteId      String                 @map("lote_id")
  numero      Int                    @map("numero")
  tamanoBytes Int                    @map("tamano_bytes")
  contenido   Bytes                  @map("contenido")
  creadoEn    DateTime               @default(now()) @map("creado_en") @db.Timestamptz(3)
  archivo     BalanceArchivoTemporal @relation(fields: [loteId], references: [loteId], onDelete: Cascade)

  @@unique([loteId, numero])
  @@index([loteId])
  @@map("balance_archivo_temporal_parte")
}

// Encabezado de un LOTE de importación (borrador persistente). Un registro por
// lectura de archivo: guarda la metadata para LISTAR los borradores sin recalcular
// (archivo, NIT/período detectado, snapshot de validación) y el dueño. Persiste
// hasta que se CARGA (promueve a oficial) o se DESCARTA. FK suave a `clientes` y
// `usuarios` (Int, sin @relation).
model BalanceImportacionLote {
  id                    Int       @id @default(autoincrement()) @map("id")
  loteId                String    @unique @map("lote_id")
  clienteId             Int?      @map("cliente_id") // obligatorio antes de abrir/cargar el borrador
  archivoNombre         String    @map("archivo_nombre")
  archivoTam            String?   @map("archivo_tam")
  nitDetectado          String?   @map("nit_detectado")
  periodoInicial        DateTime? @map("periodo_inicial") @db.Date // Fecha detectada (editable al cargar)
  periodoFinal          DateTime? @map("periodo_final") @db.Date
  estandar              String?   @map("estandar")
  convencionCredito     String?   @map("convencion_credito")
  // APERTURA del informe DECLARADA por el analista en la pantalla del borrador:
  // `cuenta` (una fila por cuenta) | `tercero` (cuentas desglosadas por NIT).
  // Obligatoria para cargar el balance oficial, que la hereda. La lectura solo
  // sugiere el valor inicial (`porTercero`); no cambia el cálculo. null = sin
  // declarar todavía. Ver `lib/balance/apertura-balance.ts`.
  aperturaBalance       String?   @map("apertura_balance")
  cuentasMovimiento     Int       @default(0) @map("cuentas_movimiento")
  filasLeidas           Int       @default(0) @map("filas_leidas")
  filasExcluidas        Int       @default(0) @map("filas_excluidas")
  // Snapshot de validación (para listar sin recalcular): partida doble + ecuación.
  partidaDobleDiff      Decimal   @default(0) @map("partida_doble_diff") @db.Decimal(18, 2)
  ecuacionDiff          Decimal   @default(0) @map("ecuacion_diff") @db.Decimal(18, 2)
  cuadrado              Boolean   @default(false) @map("cuadrado")
  cargadoPor            String?   @map("cargado_por")
  cargadoPorId          Int?      @map("cargado_por_id") // dueño del borrador (FK suave a User)
  // Trazabilidad de la extracción (el PERFIL se guarda al asociar la lectura):
  // huella del layout, cómo se obtuvo el spec y el spec usado (MappingSpec plano).
  huella                String?   @map("huella")
  origenExtraccion      String?   @map("origen_extraccion") // perfil | ia | plantilla | manual
  specJson              Json?     @map("spec_json")
  // Filas del staging corregidas AUTOMÁTICAMENTE con las correcciones memorizadas
  // del cliente (banner informativo del borrador). 0 = ninguna.
  correccionesAplicadas Int       @default(0) @map("correcciones_aplicadas")
  // Versión monotónica del CONTENIDO del staging. La promoción captura este valor
  // antes del cálculo y lo revalida dentro del commit para no consumir cambios
  // concurrentes que no alcanzó a analizar.
  revisionContenido     Int       @default(0) @map("revision_contenido")
  creadoEn              DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([cargadoPorId])
  @@map("balance_importacion_lote")
}

// Staging crudo de la importación de balance (paso 1). Recibe TODAS las filas
// normalizadas del archivo —sin descartar padres/totales/descuadres— etiquetadas
// con su `tipoFila`. El paso 2 (confirmación) las relee, promueve solo las de
// movimiento al modelo normalizado y PURGA el lote. FK suave a `clientes` (Int,
// sin @relation); `clienteId` es null hasta que se confirma el cliente.
model BalanceImportacionStaging {
  id                       Int       @id @default(autoincrement()) @map("id")
  loteId                   String    @map("lote_id") // uuid por sesión de importación
  clienteId                Int?      @map("cliente_id") // obligatorio antes de abrir/cargar el borrador
  hoja                     String?   @map("hoja")
  filaNum                  Int       @map("fila_num") // índice 1-based de la fila origen
  codigoCrudo              String    @map("codigo_crudo") // texto tal cual del archivo
  codigo                   String    @map("codigo") // normalizado ("" si no numérico)
  nombre                   String    @map("nombre")
  nivel                    Int?      @map("nivel") // longitud PUC del código (2/4/6/8)
  tipoFila                 String    @map("tipo_fila") // movimiento | agrupadora | total | excluida | descuadre
  // Clasificación fijada MANUALMENTE por un auditor en el borrador. Permite conservar
  // una agrupadora aunque todavía no tenga hijas, sin alterar la detección automática.
  tipoFilaForzado          String?   @map("tipo_fila_forzado") // agrupadora | movimiento | null
  saldoInicial             Decimal   @default(0) @map("saldo_inicial") @db.Decimal(18, 2)
  debitos                  Decimal   @default(0) @map("debitos") @db.Decimal(18, 2)
  creditos                 Decimal   @default(0) @map("creditos") @db.Decimal(18, 2)
  saldoFinal               Decimal   @default(0) @map("saldo_final") @db.Decimal(18, 2)
  // Desacople MANUAL: el usuario forzó que esta cuenta se anide por PREFIJO de código
  // (su padre real), no por el orden del archivo. Corrige un detalle que el ERP ubicó
  // bajo una agrupadora de código ajeno y de menor nivel (p. ej. `145020` bajo `1305`).
  desacoplada              Boolean   @default(false) @map("desacoplada")
  // Omitir MANUAL (TRI-ESTADO): null = sin tocar (elegible para el auto-marcado del
  // re-listado con guiones), true = omitida (se conserva en el crudo pero se excluye de
  // cálculos y carga), false = RESCATADA a mano con «Incluir» (cuenta en todas partes;
  // el auto-marcado la respeta). El override manual gana siempre.
  omitida                  Boolean?  @map("omitida")
  // Re-parentado MANUAL (tabulador): `filaNum` de la agrupadora bajo la que el usuario
  // colgó esta fila (indentar/desindentar), cuando la anidación automática la ubica mal
  // (p. ej. un código con guiones huérfano `1105-10-19` que debe ir bajo `110510`).
  // null = sin override.
  padreManual              Int?      @map("padre_manual")
  // Revisión obligatoria cuando un re-parentado manual cruza la cuenta hacia otra
  // clase contable. Permanece en el staging mientras exista el borrador y la
  // auditoría conserva la trazabilidad después de promoverlo.
  justificacionReubicacion String?   @map("justificacion_reubicacion") @db.Text
  reubicacionRevisadaPor   String?   @map("reubicacion_revisada_por")
  reubicacionRevisadaPorId Int?      @map("reubicacion_revisada_por_id") // FK suave a usuarios
  reubicacionRevisadaEn    DateTime? @map("reubicacion_revisada_en") @db.Timestamptz(3)
  creadoEn                 DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([loteId])
  @@index([clienteId])
  @@map("balance_importacion_staging")
}

// HUELLA DIAGNÓSTICA de la lectura de un balance (medición, NO afecta la lectura). Una
// fila por evento de importación, con FK SUAVE a `lote_id`/`cliente_id` (sin @relation)
// para que SOBREVIVA a la purga del lote/staging al confirmar o descartar. Acumula el
// dataset para decidir con datos si la cola de heurísticas converge o hay que rediseñar.
// `heuristicas` es JSON flexible con los conteos por pasada (ver `DiagnosticoLectura`).
model BalanceLecturaDiagnostico {
  id                   Int      @id @default(autoincrement()) @map("id")
  loteId               String   @map("lote_id") // ref suave; sobrevive a la purga del lote
  clienteId            Int?     @map("cliente_id")
  archivoNombre        String   @map("archivo_nombre")
  modo                 String?  @map("modo") // tabular | documento
  formato              String?  @map("formato") // xlsx | csv | pdf | json
  filas                Int      @default(0) @map("filas")
  movimientos          Int      @default(0) @map("movimientos")
  // Cuadre AUTOMÁTICO (antes de edición manual): ¿acertó solo el modelo?
  cuadradoInicial      Boolean  @default(false) @map("cuadrado_inicial")
  // Ciclo de vida del cargue
  resultado            String   @default("borrador") @map("resultado") // borrador | reemplazado | reprocesado (legado) | cargado | descartado | error
  cuadradoFinal        Boolean? @map("cuadrado_final")
  // Intervención MANUAL (toma final; 0 = la heurística bastó)
  manualOmitidas       Int      @default(0) @map("manual_omitidas")
  manualReparentadas   Int      @default(0) @map("manual_reparentadas")
  manualDesacopladas   Int      @default(0) @map("manual_desacopladas")
  // Reclasificar (agrupadora↔movimiento) e invertir (débito↔crédito) mutan el
  // staging sin dejar marca durable → se ACUMULAN al aplicarse (no al cerrar).
  manualReclasificadas Int      @default(0) @map("manual_reclasificadas")
  // DEPRECADO: la feature manual «lados invertidos» (⇄ débito/crédito) se eliminó; el
  // signo contrario se maneja por columna con «alerta de magnitud». Columna sin uso.
  manualInvertidas     Int      @default(0) @map("manual_invertidas")
  // Hipótesis del diagnóstico asistido con IA del descuadre (última corrida),
  // para analizar qué causas recurren. Null = nunca se pidió.
  diagnosticoIa        Json?    @map("diagnostico_ia")
  // Huella detallada de cada pasada heurística + forma del código (flexible)
  heuristicas          Json     @map("heuristicas")
  creadoEn             DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn        DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([loteId])
  @@map("balance_lectura_diagnostico")
}

// Perfil de CARGA por cliente: memoria de la ESTRUCTURA del archivo de balance
// (el MappingSpec de la extracción, aplanado) llaveada por la HUELLA del layout
// (hash del encabezado normalizado + hoja). En cargas siguientes con la misma
// huella el spec se aplica de forma DETERMINISTA (sin llamada a IA). Se guarda
// automáticamente en cuanto la lectura queda asociada al cliente y se gestiona
// desde su ficha. FK suave a `clientes` y `usuarios` (Int, sin @relation).
model PerfilCargaBalance {
  id                   Int       @id @default(autoincrement()) @map("id")
  clienteId            Int       @map("cliente_id")
  huella               String    @map("huella") // sha256 hex corto (16) del encabezado+hoja
  // ---- MappingSpec aplanado (columnas 1-based, A=1; 0 = la columna no existe) ----
  hoja                 String    @map("hoja")
  filaEncabezado       Int       @map("fila_encabezado")
  primeraFilaDatos     Int       @map("primera_fila_datos")
  colCodigo            Int       @map("col_codigo")
  colCodigoFragmentos  Json      @default("[]") @map("col_codigo_fragmentos")
  colNombre            Int       @map("col_nombre")
  colSaldoInicial      Int       @map("col_saldo_inicial")
  colDebitos           Int       @map("col_debitos")
  colCreditos          Int       @map("col_creditos")
  colSaldoFinal        Int       @map("col_saldo_final")
  colSaldoFinalDebito  Int       @map("col_saldo_final_debito")
  colSaldoFinalCredito Int       @map("col_saldo_final_credito")
  colTercero           Int       @map("col_tercero")
  signoCredito         String    @map("signo_credito") // firmado | magnitud
  reglaDetalleTipo     String    @map("regla_detalle_tipo") // prefijo | columna
  reglaDetalleColumna  Int?      @map("regla_detalle_columna")
  reglaDetalleValor    String?   @map("regla_detalle_valor")
  agregarPorTercero    Boolean   @default(false) @map("agregar_por_tercero")
  // ---- metadatos del perfil ----
  origen               String    @map("origen") // ia | manual (manual NUNCA se degrada a ia)
  vecesUsado           Int       @default(0) @map("veces_usado")
  ultimoUsoEn          DateTime? @map("ultimo_uso_en") @db.Timestamptz(3)
  archivoEjemplo       String?   @map("archivo_ejemplo") // nombre del archivo que originó el perfil
  creadoPor            String?   @map("creado_por")
  creadoPorId          Int?      @map("creado_por_id")
  creadoEn             DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn        DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@unique([clienteId, huella])
  @@index([huella])
  @@map("perfiles_carga_balance")
}

// Preferencias por defecto del CLIENTE para la carga de balances (una fila por
// cliente). Esta fila es también el PERFIL BASE obligatorio, incluso para PDF o
// plantillas que no tienen mapa de columnas. Los campos de lectura pueden quedar
// en null = «auto»; cuando el cliente se resuelve o se elige, los valores fijados
// pisan lo detectado. Una migración instala además un trigger sobre `clientes`
// para crear esta fila desde el nacimiento del cliente. FK suave a `clientes`
// (Int, sin @relation).
model AjustesCargaBalance {
  id                Int      @id @default(autoincrement()) @map("id")
  clienteId         Int      @unique @map("cliente_id")
  hojaPreferida     String?  @map("hoja_preferida")
  convencionCredito String?  @map("convencion_credito") // firmado | magnitud | null=auto
  estandar          String   @default("NIF") @map("estandar") // NIF fijo por regla de negocio
  agregarPorTercero Boolean? @map("agregar_por_tercero") // null=auto
  // Export TOTALMENTE JERÁRQUICO (cada nivel exportado con su saldo = Σ del detalle,
  // p. ej. SIESA con subcuenta + auxiliares como filas imputables): imputar SOLO las
  // hojas (el nivel más profundo) y tratar los niveles superiores como agrupadoras,
  // para evitar el doble conteo. null/false=auto/off. Opt-in por cliente porque es
  // agresivo (en un balance MIXTO borraría el saldo propio de una cuenta con detalle).
  imputarSoloHojas  Boolean? @map("imputar_solo_hojas")
  // Notas / observaciones de carga por cliente (texto libre): particularidades del formato
  // que el analista quiere recordar (p. ej. "duplica renglones UC/CU — se omite uno").
  // Se muestran al cargar/revisar el balance de ese cliente. null/"" = sin notas.
  observaciones     String?  @map("observaciones") @db.Text
  actualizadoPor    String?  @map("actualizado_por")
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@map("ajustes_carga_balance")
}

// CORRECCIONES por CUENTA memorizadas del cliente (el perfil de carga a nivel de
// fila). Cada ajuste manual del borrador (reclasificar agrupadora↔movimiento,
// desacoplar, omitir/rescatar, re-parentar) se memoriza aquí al
// «Guardar cambios» y se RE-APLICA solo al leer el siguiente balance del mismo
// cliente (por NIT, o al elegirlo en la compuerta del borrador), con las mismas
// salvaguardas deterministas del guardado manual. La clave `cuenta` es el código
// PUC de la fila; para filas sin código numérico (pies/totales del ERP) es el
// texto crudo. FK suave a `clientes` (Int, sin @relation).
model CorreccionCargaBalance {
  id              Int       @id @default(autoincrement()) @map("id")
  clienteId       Int       @map("cliente_id")
  cuenta          String    @map("cuenta")
  nombre          String?   @map("nombre") // último nombre visto (referencia en la UI)
  tipoFilaForzado String?   @map("tipo_fila_forzado") // agrupadora | movimiento | null=sin corrección
  // DEPRECADO: la feature manual «lados invertidos» (⇄ débito/crédito) se eliminó; el
  // signo contrario se maneja por columna con «alerta de magnitud». Columna sin uso.
  invertirLados   Boolean   @default(false) @map("invertir_lados")
  desacoplada     Boolean?  @map("desacoplada") // null=sin corrección
  // Tri-estado como el staging: true = omitir; false = RESCATADA (el auto-marcado
  // la respeta); null = sin corrección.
  omitida         Boolean?  @map("omitida")
  padreCodigo     String?   @map("padre_codigo") // re-parentar bajo la fila con esta clave
  vecesAplicada   Int       @default(0) @map("veces_aplicada")
  ultimoUsoEn     DateTime? @map("ultimo_uso_en") @db.Timestamptz(3)
  actualizadoPor  String?   @map("actualizado_por")
  creadoEn        DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn   DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@unique([clienteId, cuenta])
  @@map("correcciones_carga_balance")
}

// ===== Motor GENÉRICO de importación de módulos =====
// Los 6 módulos de conciliación (Inventarios, Cartera, Cuentas por Pagar, Ingresos,
// Activos Fijos, Nómina) comparten UNA maquinaria: leer Excel → mapear columnas →
// staging editable → perfiles/correcciones por cliente → promover a oficial →
// consolidar por un CLASIFICADOR → cuenta de 4 díg. Discriminador `modulo_codigo`
// (= `Module.code`: INV/CAR/CXP/ING/AFI/NOM). Las columnas propias de cada módulo viven
// en `datos` (JSON); solo se promueven a columnas el `clasificador` (dimensión de
// consolidación) y el `valor` (lo que se suma). La forma de cada módulo está en código
// (`src/lib/modulos/descriptores.ts`), no en BD. FK suave `Int` a `clientes` (sin @relation).

model ModuloImportacionLote {
  id                    Int       @id @default(autoincrement()) @map("id")
  moduloCodigo          String    @map("modulo_codigo") // INV | CAR | CXP | ING | AFI | NOM
  loteId                String    @unique @map("lote_id") // uuid del navegador = idempotencia
  clienteId             Int?      @map("cliente_id")
  archivoNombre         String    @map("archivo_nombre")
  archivoTam            String?   @map("archivo_tam")
  periodoInicial        DateTime? @map("periodo_inicial") @db.Date
  periodoFinal          DateTime? @map("periodo_final") @db.Date
  filasLeidas           Int       @default(0) @map("filas_leidas")
  filasExcluidas        Int       @default(0) @map("filas_excluidas")
  huella                String?   @map("huella")
  origenExtraccion      String?   @map("origen_extraccion") // perfil | ia | plantilla | manual
  specJson              Json?     @map("especificacion_json")
  correccionesAplicadas Int       @default(0) @map("correcciones_aplicadas")
  cargadoPor            String?   @map("cargado_por")
  cargadoPorId          Int?      @map("cargado_por_id")
  creadoEn              DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn         DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([moduloCodigo, clienteId])
  @@map("modulo_importacion_lote")
}

model ModuloImportacionStaging {
  id              Int      @id @default(autoincrement()) @map("id")
  loteId          String   @map("lote_id")
  moduloCodigo    String   @map("modulo_codigo")
  clienteId       Int?     @map("cliente_id")
  hoja            String?  @map("hoja")
  filaNum         Int      @map("fila_num")
  // Columnas COMUNES promovidas (para consolidar sin abrir el JSON):
  clasificador    String?  @map("clasificador") // p. ej. tipo de inventario
  valor           Decimal  @default(0) @map("valor") @db.Decimal(18, 2)
  // Columnas propias del módulo (referencia, descripcion, cantidad, valorUnitario…):
  datos           Json     @default("{}") @map("datos")
  // Estado de edición manual (mismo tri-estado del balance):
  tipoFila        String   @default("movimiento") @map("tipo_fila") // movimiento | agrupadora | total
  tipoFilaForzado String?  @map("tipo_fila_forzado") // agrupadora | movimiento | null
  omitida         Boolean? @map("omitida") // tri-estado: true omitir · false rescatar · null sin tocar
  padreManual     Int?     @map("padre_manual")
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([loteId])
  @@index([moduloCodigo, clienteId])
  @@map("modulo_importacion_staging")
}

model ModuloDatoEncabezado {
  id               Int                 @id @default(autoincrement()) @map("id")
  moduloCodigo     String              @map("modulo_codigo")
  loteId           String?             @unique @map("lote_id") // idempotencia de promoción; null para legado
  clienteId        Int                 @map("cliente_id")
  nombreCliente    String              @map("nombre_cliente")
  periodo          String              @map("periodo") // etiqueta del período (p. ej. "2026-03")
  version          Int                 @default(1) @map("version")
  esOficial        Boolean             @default(true) @map("es_oficial")
  estaCongelado    Boolean             @default(false) @map("esta_congelado")
  congeladoPor     String?             @map("congelado_por")
  congeladoEn      DateTime?           @map("congelado_en") @db.Timestamptz(3)
  filas            Int                 @default(0) @map("filas")
  total            Decimal             @default(0) @map("total") @db.Decimal(18, 2)
  archivoNombre    String?             @map("archivo_nombre")
  archivoTam       String?             @map("archivo_tam")
  origenExtraccion String?             @map("origen_extraccion") // perfil | manual | ia
  // Novedades de la carga (estilo balance): observaciones libres + respuestas del checklist
  // de verificación (JSON id→{respuesta, nota}). Las alertas automáticas (p. ej. negativos)
  // NO se guardan: se recalculan al leer desde el detalle.
  observaciones    String?             @map("observaciones")
  verificaciones   Json?               @map("verificaciones")
  cargadoPor       String?             @map("cargado_por")
  cargadoPorId     Int?                @map("cargado_por_id")
  ultimaCarga      DateTime            @default(now()) @map("ultima_carga") @db.Timestamptz(3)
  creadoEn         DateTime            @default(now()) @map("creado_en") @db.Timestamptz(3)
  detalles         ModuloDatoDetalle[]

  @@unique([clienteId, moduloCodigo, periodo, version])
  @@index([moduloCodigo, clienteId])
  @@map("modulo_dato_encabezado")
}

/// Justificación de una DIFERENCIA del cruce contable de un módulo (saldo del balance
/// de comprobación vs. valor consolidado de los archivos del módulo), por cuenta Russell
/// de 4 dígitos.
///
/// Se ancla al PERÍODO del cliente —no al cargue—, de modo que sobrevive a las versiones
/// nuevas del mismo período: volver a cargar el archivo no obliga a reescribir las
/// justificaciones. `diferencia` congela el monto que se justificó, para poder avisar
/// cuando la diferencia actual ya no es la misma. FK suaves a cliente, usuario y
/// comentario (el rastro en el hilo de la cuenta): borrar el comentario no borra la
/// justificación. Reversible.
model JustificacionCruceModulo {
  id               Int      @id @default(autoincrement()) @map("id")
  clienteId        Int      @map("cliente_id")
  moduloCodigo     String   @map("modulo_codigo")
  periodo          String   @map("periodo") // etiqueta del período (p. ej. "2025-12")
  cuenta4          String   @map("cuenta_4") // cuenta Russell de 4 dígitos
  nota             String   @map("nota")
  diferencia       Decimal  @default(0) @map("diferencia") @db.Decimal(18, 2)
  comentarioId     Int?     @map("comentario_id")
  justificadoPor   String?  @map("justificado_por")
  justificadoPorId Int?     @map("justificado_por_id")
  justificadoEn    DateTime @default(now()) @map("justificado_en") @db.Timestamptz(3)

  @@unique([clienteId, moduloCodigo, periodo, cuenta4], map: "justificacion_cruce_modulo_unica")
  @@index([clienteId, moduloCodigo, periodo], map: "justificacion_cruce_modulo_periodo_idx")
  @@map("justificacion_cruce_modulo")
}

model ModuloDatoDetalle {
  id           Int                  @id @default(autoincrement()) @map("id")
  encabezado   ModuloDatoEncabezado @relation(fields: [encabezadoId], references: [id], onDelete: Cascade)
  encabezadoId Int                  @map("encabezado_id")
  filaNum      Int                  @map("fila_num")
  clasificador String?              @map("clasificador")
  valor        Decimal              @default(0) @map("valor") @db.Decimal(18, 2)
  datos        Json                 @default("{}") @map("datos")

  @@index([encabezadoId])
  @@index([clasificador])
  @@map("modulo_dato_detalle")
}

// Perfil de CARGA por (cliente, módulo): memoria del mapeo de columnas del archivo,
// llaveada por la HUELLA del layout. En cargas siguientes con la misma huella el spec se
// aplica DETERMINISTA (0 IA). FK suave a `clientes` (Int, sin @relation).
model PerfilCargaModulo {
  id             Int       @id @default(autoincrement()) @map("id")
  clienteId      Int       @map("cliente_id")
  moduloCodigo   String    @map("modulo_codigo")
  huella         String    @map("huella")
  specJson       Json      @map("especificacion_json") // spec de mapeo (rol interno → columna 1-based, hoja, filas)
  origen         String    @map("origen") // ia | manual (manual NUNCA se degrada a ia)
  vecesUsado     Int       @default(0) @map("veces_usado")
  ultimoUsoEn    DateTime? @map("ultimo_uso_en") @db.Timestamptz(3)
  archivoEjemplo String?   @map("archivo_ejemplo")
  creadoPor      String?   @map("creado_por")
  creadoPorId    Int?      @map("creado_por_id")
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@unique([clienteId, moduloCodigo, huella])
  @@index([huella])
  @@map("perfiles_carga_modulo")
}

// Preferencias por defecto del cliente para la carga de un módulo (una fila por
// cliente+módulo). FK suave a `clientes` (Int, sin @relation).
model AjustesCargaModulo {
  id             Int      @id @default(autoincrement()) @map("id")
  clienteId      Int      @map("cliente_id")
  moduloCodigo   String   @map("modulo_codigo")
  hojaPreferida  String?  @map("hoja_preferida")
  observaciones  String?  @map("observaciones") @db.Text
  actualizadoPor String?  @map("actualizado_por")
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@unique([clienteId, moduloCodigo])
  @@map("ajustes_carga_modulo")
}

// Correcciones por fila memorizadas al editar el borrador (marcar «agrupador», omitir),
// re-aplicadas en cargas siguientes del mismo cliente+módulo. Clave estable entre
// archivos (referencia / clasificador+referencia).
model CorreccionCargaModulo {
  id              Int       @id @default(autoincrement()) @map("id")
  clienteId       Int       @map("cliente_id")
  moduloCodigo    String    @map("modulo_codigo")
  clave           String    @map("clave")
  nombre          String?   @map("nombre")
  tipoFilaForzado String?   @map("tipo_fila_forzado") // agrupadora | movimiento | null
  omitida         Boolean?  @map("omitida") // tri-estado
  vecesAplicada   Int       @default(0) @map("veces_aplicada")
  ultimoUsoEn     DateTime? @map("ultimo_uso_en") @db.Timestamptz(3)
  actualizadoPor  String?   @map("actualizado_por")
  creadoEn        DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn   DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@unique([clienteId, moduloCodigo, clave])
  @@map("correcciones_carga_modulo")
}

// Consolidación POR CLIENTE: cada clasificador (p. ej. tipo de inventario) cruza contra
// una cuenta de 4 díg del plan estándar. Alimenta la pestaña «Consolidado» y el futuro
// cruce contra el balance. FK suave a `clientes` (Int, sin @relation).
model ConsolidacionModuloCliente {
  id             Int      @id @default(autoincrement()) @map("id")
  clienteId      Int      @map("cliente_id")
  moduloCodigo   String   @map("modulo_codigo")
  clasificador   String   @map("clasificador")
  cuenta4        String   @map("cuenta_4") // cuenta de 4 díg contra la que cruza
  actualizadoPor String?  @map("actualizado_por")
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  // Un clasificador puede cruzar con UNA o VARIAS cuentas de 4 díg (p. ej. el inventario
  // globalizado contra 1405+1430+1435). La unicidad incluye la cuenta: una fila por par.
  @@unique([clienteId, moduloCodigo, clasificador, cuenta4], map: "consolidacion_modulo_cliente_clasif_cuenta_key")
  @@index([moduloCodigo, clienteId])
  @@index([clienteId, moduloCodigo, clasificador], map: "consolidacion_modulo_cliente_cliente_id_modulo_codigo_clasi_idx")
  @@map("consolidacion_modulo_cliente")
}

// ===== Prevalidador de homologación =====
// Catálogo GLOBAL de plataforma: qué cuentas del plan estándar Russell se comparan
// contra el PUC del cliente antes de conciliar, y bajo qué módulo se agrupan. El
// informe suma las MISMAS filas de `balance_prueba_detalle` por dos columnas
// distintas —prefijo de `cuenta_6_russell` vs. prefijo de `cuenta_8`— para destapar
// errores de homologación. Solo cubre las cuentas de los 6 módulos del ERP que se
// concilian; el resto del balance no se prevalida.
//
// Se administra en /config/prevalidador (permiso `parametros:administrar`); las 11
// filas de fábrica las siembra la migración. NO reemplaza a `opciones_russell`
// (tabla legado sin uso en código, con otra semántica).
model PrevalidadorCuenta {
  id             Int      @id @default(autoincrement()) @map("id")
  module         Module   @relation(fields: [moduloId], references: [id], onDelete: Restrict)
  moduloId       Int      @map("modulo_id")
  // PREFIJO del plan estándar Russell: "41" (grupo) o "2805" (cuenta).
  cuentaRussell  String   @map("cuenta_russell")
  // Nombre legible; solo apoya la lectura (el informe muestra el código).
  etiqueta       String?  @map("etiqueta")
  // saldo = Σ saldo_final (clases 1-3) · movimiento = Σ (debitos − creditos)
  // (clases 4-7, para no arrastrar el saldo inicial acumulado). El defecto sale de
  // la clase, pero es editable: el criterio contable lo fija Russell, no el código.
  baseCalculo    String   @default("saldo") @map("base_calculo")
  orden          Int      @default(0) @map("orden")
  activa         Boolean  @default(true) @map("activa")
  actualizadoPor String?  @map("actualizado_por")
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  overrides PrevalidadorCuentaBalance[]

  // Único por MÓDULO (no global): impide repetir el prefijo dentro de un módulo,
  // pero deja que Russell use el mismo prefijo en dos módulos si lo necesita.
  @@unique([moduloId, cuentaRussell])
  @@index([activa, orden])
  @@map("prevalidador_cuentas")
}

// Cuenta del CLIENTE contra la que se compara una fila del catálogo en UN BALANCE
// concreto. No se propaga entre períodos: cada versión conserva su propia decisión
// y un balance congelado no admite cambios posteriores.
model PrevalidadorCuentaBalance {
  id             Int                     @id @default(autoincrement()) @map("id")
  balance        BalancePruebaEncabezado @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  balanceId      Int                     @map("balance_id")
  catalogo       PrevalidadorCuenta      @relation(fields: [catalogoId], references: [id], onDelete: Cascade)
  catalogoId     Int                     @map("catalogo_id")
  cuentaCliente  String                  @map("cuenta_cliente")
  actualizadoPor String?                 @map("actualizado_por")
  creadoEn       DateTime                @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime                @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@unique([balanceId, catalogoId])
  @@index([balanceId])
  @@map("prevalidador_cuentas_balance")
}

// Archivo de solo conservación creado al migrar los antiguos overrides globales
// por cliente. No participa en el cálculo; evita perder excepciones que no pudieron
// asociarse a un balance existente o que tenían un prefijo legado inválido.
model PrevalidadorCuentaCliente {
  id             Int      @id @default(autoincrement()) @map("id")
  clienteId      Int      @map("cliente_id")
  catalogoId     Int      @map("catalogo_id")
  cuentaCliente  String   @map("cuenta_cliente")
  actualizadoPor String?  @map("actualizado_por")
  creadoEn       DateTime @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime @map("actualizado_en") @db.Timestamptz(3)
  archivadoEn    DateTime @default(now()) @map("archivado_en") @db.Timestamptz(3)

  @@unique([clienteId, catalogoId])
  @@index([clienteId])
  @@map("prevalidador_cuentas_cliente_legacy")
}

// Historial append-only de aprobación/revocación del prevalidador. `huella`
// identifica exactamente detalle + catálogo + overrides; `instantanea` conserva
// el resultado que el servidor volvió a calcular dentro de la misma transacción.
model PrevalidadorRevisionBalance {
  id            Int                     @id @default(autoincrement()) @map("id")
  balance       BalancePruebaEncabezado @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  balanceId     Int                     @map("balance_id")
  estado        String                  @map("estado") // aprobada | revocada
  justificacion String                  @map("justificacion")
  huella        String                  @map("huella")
  instantanea   Json?                   @map("instantanea")
  actor         String                  @map("actor")
  actorId       Int?                    @map("actor_id") // FK lógica a User.id
  creadoEn      DateTime                @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([balanceId, creadoEn])
  @@index([huella])
  @@map("prevalidador_revisiones_balance")
}

// ===== Impuestos · DIAN =====
model DianForm {
  id          Int              @id @default(autoincrement()) @map("id")
  key         String           @unique @map("clave") // IVA, RETEFUENTE...
  name        String           @map("nombre")
  code        String           @map("codigo") // F-300
  periodicity String           @map("periodicidad")
  icon        String           @map("icono")
  objective   String?          @map("objetivo")
  conclusion  String?          @map("conclusion")
  periods     DianPeriod[]
  sections    DianSection[]
  mappings    DianMapping[]
  comments    DianComment[]
  clientForms ClientDianForm[]

  @@map("formularios_dian")
}

model DianPeriod {
  id        Int       @id @default(autoincrement()) @map("id")
  periodKey String    @map("clave_periodo") // 2026-B5
  label     String    @map("etiqueta")
  status    String    @map("estado") // OK | DIFF | PEND
  filed     DateTime? @map("presentado") @db.Date
  form      DianForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    Int       @map("formulario_id")

  @@unique([formId, periodKey])
  @@map("periodos_dian")
}

model DianSection {
  id     Int        @id @default(autoincrement()) @map("id")
  key    String     @unique @map("clave")
  form   DianForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId Int        @map("formulario_id")
  title  String     @map("titulo")
  side   String     @default("L") @map("lado") // L | R (lado visual)
  note   String?    @map("nota")
  order  Int        @default(0) @map("orden")
  lines  DianLine[]

  @@map("secciones_dian")
}

model DianLine {
  id        Int         @id @default(autoincrement()) @map("id")
  section   DianSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId Int         @map("seccion_id")
  k         String      @map("casilla") // casilla: GEN-19, DES-CBG...
  label     String      @map("etiqueta")
  decl      Float       @default(0) @map("declarado")
  cont      Float       @default(0) @map("contabilidad")
  diff      Float       @default(0) @map("diferencia")
  order     Int         @default(0) @map("orden")

  @@map("renglones_dian")
}

model DianMapping {
  id      Int      @id @default(autoincrement()) @map("id")
  form    DianForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId  Int      @map("formulario_id")
  lineKey String   @map("clave_renglon") // k del renglón
  account String   @map("cuenta")
  desc    String   @map("descripcion")
  sign    String   @map("signo") // + | -
  order   Int      @default(0) @map("orden")

  @@map("mapeos_dian")
}

model DianComment {
  id        Int      @id @default(autoincrement()) @map("id")
  form      DianForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    Int      @map("formulario_id")
  lineKey   String   @map("clave_renglon")
  who       String   @map("autor")
  initials  String   @map("iniciales")
  text      String   @map("texto")
  isAI      Boolean  @default(false) @map("es_ia")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@map("comentarios_dian")
}

// ===== Cuentas del cliente (PUC) + sus dos mapeos =====
// Tabla ÚNICA de las cuentas de cada cliente. Sostiene DOS mapeos sobre la misma
// fila: (1) `russellOption` → módulo de conciliación (Caja/Bancos/DIAN…), y
// (2) `cuenta6Russell` → cuenta estándar del plan (6 díg) para el BALANCE. El
// importador de balances registra/actualiza aquí las cuentas del cliente y su
// mapeo estándar (memoria entre períodos): al cargar otro período, este mapeo se
// aplica primero. `origenMapeo=manual` (asignación a mano) no se pisa por mapeos
// automáticos. FK suave a Client por `clienteId` (Int, sin @relation); el
// `clientName` se conserva como clave del módulo de conciliación.
model ClientAccount {
  id              Int            @id @default(autoincrement()) @map("id")
  clientName      String         @map("nombre_cliente") // se conserva para el módulo de conciliación
  clienteId       Int?           @map("cliente_id") // FK suave a Client: identidad ESTABLE del balance
  nit             String?        @map("nit") // NIT del cliente (identificador legible de negocio)
  code            String         @map("codigo")
  level           Int            @map("nivel") // 4 | 6 | 8
  name            String         @map("nombre")
  russellOption   RussellOption? @relation(fields: [russellOptionId], references: [id], onDelete: SetNull)
  russellOptionId Int?           @map("opcion_russell_id")
  order           Int            @default(0) @map("orden")
  // Mapeo al plan estándar Russell (BALANCE): cuenta estándar de 6 díg + % y origen.
  cuenta6Russell  String?        @map("cuenta_6_russell")
  coincidencia    Decimal?       @map("porcentaje_coincidencia") @db.Decimal(5, 2)
  origenMapeo     String?        @map("origen_mapeo") // manual | automatico
  actualizadoPor  String?        @map("actualizado_por")
  actualizadoEn   DateTime?      @map("actualizado_en") @db.Timestamptz(3)

  // Conciliación llavea por (nombre_cliente, código); el BALANCE llavea por
  // (cliente_id, código) — inmutable, a prueba de cambios de nombre.
  @@unique([clientName, code])
  @@unique([clienteId, code])
  @@map("cuentas_cliente")
}

model RussellOption {
  id       Int             @id @default(autoincrement()) @map("id")
  code     String          @unique @map("codigo") // 1105, 1110, 41...
  name     String          @map("nombre")
  module   String?         @map("modulo") // Caja, Bancos, Cartera, DIAN... (null = no participa en conciliaciones)
  accounts ClientAccount[]

  @@map("opciones_russell")
}

// ===== Novedades · changelog + control de versiones (Configuración) =====
// Bitácora de evolución de la PLATAFORMA, visible SOLO para administradores
// (gates novedades:ver / novedades:administrar). El ENCABEZADO es una VERSIÓN
// (timeline de avance: borrador → publicada); el DETALLE es un CAMBIO por fila,
// con su guía de operación (texto multilínea, una línea por paso), un ejemplo y
// un deep-link a la ruta interna real para "probar" la funcionalidad.
//
// FK DURA cambios_version → versiones_plataforma con onDelete: Cascade (borrar
// una versión arrastra sus cambios). `createdById` es FK LÓGICA a User (solo
// Int, sin @relation): el changelog se conserva aunque el autor se elimine.
model PlatformVersion {
  id          Int       @id @default(autoincrement()) @map("id")
  number      String    @unique @map("numero") // versión legible: "1.2.0"
  title       String    @map("titulo")
  summary     String?   @map("resumen")
  status      String    @default("borrador") @map("estado") // borrador | publicada
  releasedAt  DateTime? @map("publicado_en") @db.Timestamptz(3) // instante de publicación
  order       Int       @default(0) @map("orden") // orden manual del timeline
  createdById Int?      @map("creado_por_id") // FK lógica a User.id (autor)
  createdAt   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  changes VersionChange[]

  @@index([status])
  @@map("versiones_plataforma")
}

model VersionChange {
  id            Int             @id @default(autoincrement()) @map("id")
  versionId     Int             @map("version_id")
  version       PlatformVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  type          String          @map("tipo") // nueva | mejora | correccion | seguridad
  title         String          @map("titulo")
  description   String          @map("descripcion")
  moduleKey     String?         @map("modulo") // clave de PlatformModule afectado (opcional)
  route         String?         @map("ruta") // deep-link interno, p. ej. "/balance"
  howTo         String?         @map("como_operar") // pasos: texto multilínea (1 línea = 1 paso)
  example       String?         @map("ejemplo") // ejemplo práctico
  featureStatus String          @default("disponible") @map("estado_funcionalidad") // disponible | en_desarrollo | planeada
  order         Int             @default(0) @map("orden")
  createdAt     DateTime        @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([versionId])
  @@map("cambios_version")
}

model ReporteNovedadesIA {
  id               Int      @id @default(autoincrement()) @map("id")
  huellaContexto   String   @unique @map("huella_contexto")
  modelo           String   @map("modelo")
  titulo           String   @map("titulo")
  html             String   @map("html")
  totalVersiones   Int      @map("total_versiones")
  totalCambios     Int      @map("total_cambios")
  cambiosIncluidos Int      @map("cambios_incluidos")
  creadoPorId      Int?     @map("creado_por_id")
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([modelo])
  @@map("reportes_novedades_ia")
}

// Caché de reportes ejecutivos de uso y adopción (Auditoría).
// Una fila por huella del contexto factual (período + métricas + novedades +
// adopción). Mismo patrón que `reportes_novedades_ia`: reutiliza el HTML si el
// contexto no cambió. `creadoPorId` es FK lógica a User (sin @relation).
model ReporteEjecutivoUsoIA {
  id             Int      @id @default(autoincrement()) @map("id")
  huellaContexto String   @unique @map("huella_contexto")
  modelo         String   @map("modelo")
  titulo         String   @map("titulo")
  html           String   @map("html")
  periodoDesde   DateTime @map("periodo_desde") @db.Timestamptz(3)
  periodoHasta   DateTime @map("periodo_hasta") @db.Timestamptz(3)
  totalAcciones  Int      @map("total_acciones")
  totalUsuarios  Int      @map("total_usuarios")
  totalNovedades Int      @map("total_novedades")
  creadoPorId    Int?     @map("creado_por_id")
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([modelo])
  @@map("reportes_ejecutivos_uso_ia")
}

// Registro de reportes ejecutivos ENVIADOS al cliente. Existe para NO repetir
// avances ya comunicados: la siguiente generación preselecciona solo las
// versiones de Novedades que no aparecen en ningún envío previo.
// `enviadoPorId` es FK lógica a User (sin @relation).
model EnvioReporteEjecutivo {
  id             Int      @id @default(autoincrement()) @map("id")
  titulo         String   @map("titulo")
  periodoDesde   DateTime @map("periodo_desde") @db.Timestamptz(3)
  periodoHasta   DateTime @map("periodo_hasta") @db.Timestamptz(3)
  versionIds     Int[]    @map("ids_version")
  totalNovedades Int      @default(0) @map("total_novedades")
  totalAcciones  Int      @default(0) @map("total_acciones")
  canal          String   @default("correo") @map("canal")
  nota           String?  @map("nota")
  enviadoPor     String   @map("enviado_por")
  enviadoPorId   Int?     @map("enviado_por_id")
  enviadoEn      DateTime @default(now()) @map("enviado_en") @db.Timestamptz(3)

  @@index([enviadoEn])
  @@map("envios_reporte_ejecutivo")
}

// ===== Consumo de IA (tokens y costos de escaneos con Claude) =====
// Registro de uso de la API de Claude (Anthropic): UNA fila por LLAMADA a la API
// durante el escaneo/extracción de documentos (extracción tabular, extracción de
// PDF y mapeo por lotes). Diseño GENÉRICO (campo `tipoOperacion`) para servir a
// cualquier función de IA futura, no solo al balance. Permite contar escaneos,
// ver tokens y costo por documento/cliente, y el gasto mensual en COP.
//
// FK LÓGICAS (solo Int, sin @relation) hacia Client y User, como el resto de
// registros (AccessLog/StandardAccountLog): el histórico de costos sobrevive al
// borrado del cliente o del usuario. `usuarioNombre` va denormalizado.
//
// Costo SNAPSHOT: `costoUsd`, `trm` y `costoCop` se calculan y congelan al
// registrar, de modo que cambios futuros de tarifas o de la TRM no alteran el
// histórico. Tokens como Int; costo USD con 6 decimales (microdólares por
// llamada); costo COP con 2 decimales.
model ConsumoIA {
  id                  Int      @id @default(autoincrement()) @map("id")
  // FK lógicas (sin @relation). clienteId es opcional: en la extracción inicial
  // (lectura del archivo) el cliente aún no está confirmado.
  clienteId           Int?     @map("cliente_id")
  usuarioId           Int?     @map("usuario_id")
  usuarioNombre       String?  @map("usuario_nombre")
  // Contexto de la operación.
  modulo              String   @default("balance") @map("modulo") // reutiliza los códigos de módulo del RBAC
  tipoOperacion       String   @map("tipo_operacion") // extraccion_tabular | extraccion_pdf | mapeo_ia
  modelo              String   @map("modelo") // p. ej. claude-opus-4-8
  archivoNombre       String?  @map("archivo_nombre")
  nitDetectado        String?  @map("nit_detectado")
  loteIndice          Int?     @map("lote_indice") // mapeo por lotes: índice del lote (0-based)
  cuentasLote         Int?     @map("cuentas_lote") // cuentas enviadas en el lote
  // Tokens consumidos (los 4 componentes del `usage` de Anthropic).
  tokensEntrada       Int      @default(0) @map("tokens_entrada")
  tokensSalida        Int      @default(0) @map("tokens_salida")
  tokensCacheCreacion Int      @default(0) @map("tokens_cache_creacion")
  tokensCacheLectura  Int      @default(0) @map("tokens_cache_lectura")
  // Costo (snapshot al momento del registro).
  costoUsd            Decimal  @default(0) @map("costo_usd") @db.Decimal(12, 6)
  trm                 Decimal  @default(0) @map("trm") @db.Decimal(12, 4) // COP por 1 USD usada en la conversión
  costoCop            Decimal  @default(0) @map("costo_cop") @db.Decimal(14, 2)
  // Estado de la llamada.
  exitoso             Boolean  @default(true) @map("exitoso")
  mensajeError        String?  @map("mensaje_error")
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([creadoEn])
  @@index([clienteId, creadoEn])
  @@index([tipoOperacion, creadoEn])
  @@map("consumo_ia")
}

// ===== Tasas de cambio (TRM oficial USD→COP) =====
// Histórico de la Tasa de Cambio Representativa del Mercado (TRM) de la
// Superintendencia Financiera, obtenida de datos.gov.co (dataset 32sa-8pi3).
// `getTRM()` (src/lib/ia/trm.ts) hace UPSERT de la TRM vigente aquí y la usa de
// fallback durable si el servicio externo no responde. La conversión a COP del
// consumo de IA toma de aquí el valor vigente.
model TasaCambio {
  id            Int       @id @default(autoincrement()) @map("id")
  moneda        String    @default("USD") @map("moneda") // moneda origen (par contra COP)
  valor         Decimal   @map("valor") @db.Decimal(12, 4) // COP por 1 unidad de `moneda`
  vigenciaDesde DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime? @map("vigencia_hasta") @db.Date
  fuente        String    @default("superfinanciera") @map("fuente")
  obtenidaEn    DateTime  @default(now()) @map("obtenida_en") @db.Timestamptz(3)

  @@unique([moneda, vigenciaDesde])
  @@index([moneda, vigenciaDesde])
  @@map("tasas_cambio")
}

// Prompts de IA editables por el Superadministrador. La plataforma guarda aquí el
// CONTENIDO vigente de cada prompt de sistema (extracción de balances, mapeo de
// cuentas…) para poder verlo y editarlo desde la UI y que persista en producción
// (el sistema de archivos de Vercel es de solo lectura). `predeterminado` conserva
// el valor original del código para poder restaurarlo sin depender del disco.
// El catálogo de prompts conocidos vive en `src/lib/ia/prompts-catalogo.ts`.
model PromptIA {
  id             Int      @id @default(autoincrement()) @map("id")
  clave          String   @unique @map("clave") // identificador estable: "extraccion_balance", "mapeo_balance"
  contenido      String   @map("contenido") // texto vigente que se envía a la IA
  predeterminado String   @map("predeterminado") // valor de fábrica (para "restaurar")
  actualizadoPor String?  @map("actualizado_por")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@map("prompts_ia")
}

// Umbrales de las alertas del balance, parametrizables desde /config/parametros
// (permiso `parametros:administrar`). Son GLOBALES de plataforma: una fila por
// umbral conocido, identificada por `clave`. `predeterminado` conserva el valor
// de fábrica para poder restaurarlo. El catálogo de umbrales conocidos (nombres,
// descripciones y valores de fábrica) vive en `src/lib/balance/umbrales-alertas.ts`.
model UmbralAlerta {
  id             Int      @id @default(autoincrement()) @map("id")
  clave          String   @unique @map("clave") // identificador estable: "descuadre", "naturaleza"
  valor          Decimal  @map("valor") @db.Decimal(18, 2) // monto vigente en pesos
  predeterminado Decimal  @map("predeterminado") @db.Decimal(18, 2) // valor de fábrica (para "restaurar")
  actualizadoPor String?  @map("actualizado_por")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@map("umbrales_alertas")
}

// ===== Reportes internos (antes mesa de ayuda publica) =====
// Cualquier usuario autenticado puede crear una novedad. El portal publico
// `/soporte` se conserva para reportes sin sesion. `creadoPorId` y
// `resueltoPorId` son FK logicas a User (sin @relation): el nombre del
// reportante/tecnico se conserva aunque la cuenta se desactive o elimine.
// Los adjuntos viven en S3/MinIO; la BD solo guarda la clave del objeto.
model SupportTicket {
  id                    Int                       @id @default(autoincrement()) @map("id")
  code                  String                    @unique @map("codigo")
  createdById           Int?                      @map("creado_por_id")
  reporterFirstName     String                    @map("nombre_reportante")
  reporterLastName      String                    @map("apellido_reportante")
  subject               String                    @map("asunto")
  description           String                    @map("descripcion")
  routeKey              String?                   @map("ruta_clave")
  routeLabel            String?                   @map("ruta_etiqueta")
  menuKey               String?                   @map("menu_clave")
  menuLabel             String?                   @map("menu_etiqueta")
  status                String                    @default("abierto") @map("estado") // abierto | en_proceso | resuelto | cerrado
  solution              String?                   @map("solucion")
  resolvedById          Int?                      @map("resuelto_por_id")
  resolvedByName        String?                   @map("resuelto_por_nombre")
  resolvedAt            DateTime?                 @map("resuelto_en") @db.Timestamptz(3)
  publicAccessTokenHash String                    @unique @map("token_acceso_hash")
  createdAt             DateTime                  @default(now()) @map("creado_en") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  attachments           SupportTicketAttachment[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@index([routeKey, menuKey])
  @@map("tickets_soporte")
}

model SupportTicketAttachment {
  id          Int           @id @default(autoincrement()) @map("id")
  ticketId    Int           @map("ticket_id")
  objectKey   String        @unique @map("clave_objeto")
  fileName    String        @map("nombre_archivo")
  contentType String        @map("tipo_contenido")
  sizeBytes   Int           @map("tamano_bytes")
  createdAt   DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("adjuntos_ticket_soporte")
}

/// Variables de entorno administrables desde la UI.
///
/// La tabla la creó un `prisma db push` fuera de migraciones el 24-ago-2026 y
/// quedó sin declarar aquí, produciendo deriva de esquema: la primera
/// `prisma migrate dev` habría propuesto RESETEAR la base. Se declara para
/// cerrar esa deriva; el módulo que la consume todavía no está en el repo.
model EnvironmentVariable {
  id          Int      @id @default(autoincrement()) @map("id")
  key         String   @unique @map("clave")
  value       String?  @map("valor")
  isSecret    Boolean  @default(false) @map("es_secreto")
  description String?  @map("descripcion")
  category    String   @map("categoria")
  updatedAt   DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  updatedBy   String?  @map("actualizado_por")

  @@map("variables_entorno")
}
