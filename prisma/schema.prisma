// Schema Prisma 7 — Russell Bedford · Conciliador/Diagnóstico
// Modelos derivados de los datos demo del prototipo original (data*.jsx)
//
// Convención: la base de datos física está en ESPAÑOL.
//   - Tablas: @@map("nombre_en_espanol")
//   - Columnas: @map("columna_en_espanol")  (snake_case)
// Los identificadores del modelo Prisma se mantienen para no romper el código,
// pero el objeto real en PostgreSQL siempre queda en español.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== Autenticación =====
model User {
  id                  Int              @id @default(autoincrement()) @map("id")
  email               String           @unique @map("correo")
  password            String           @map("contrasena") // hash bcrypt
  name                String           @map("nombre")
  cedula              String?          @unique @map("cedula") // documento de identidad (único)
  cargo               String?          @map("cargo") // título de puesto (texto libre)
  role                String           @default("Consulta") @map("rol")
  initials            String           @map("iniciales")
  active              Boolean          @default(true) @map("activo")
  sessionVersion      Int              @default(0) @map("version_sesion")
  failedLoginAttempts Int              @default(0) @map("intentos_fallidos")
  lastFailedLoginAt   DateTime?        @map("ultimo_intento_fallido")
  blockedUntil        DateTime?        @map("bloqueado_hasta")
  mustChangePassword  Boolean          @default(false) @map("debe_cambiar_contrasena")
  lastLoginAt         DateTime?        @map("ultimo_inicio_sesion")
  comments            Comment[]        @relation("ComentariosAutor")
  mentions            CommentMention[] @relation("MencionesUsuario")
  createdAt           DateTime         @default(now()) @map("creado_en")
  updatedAt           DateTime         @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement()) @map("id")
  email     String   @map("correo")
  ip        String   @map("ip")
  success   Boolean  @map("exitoso")
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("intentos_inicio_sesion")
}

// ============================================================
// ===== Control de acceso y organización · Roles, permisos,
//       jerarquía organizacional y responsables por cliente =====
//
// Parametrización derivada de "RB_GCT Roles y Responsabilidades –
// Área de Revisoría Fiscal" (Russell Bedford, 04-jun-2026).
//
// El bloque nació en la migración aditiva
// 20260605235129_rbac_control_acceso. La migración posterior de IDs
// convirtió también sus claves y referencias a INTEGER. La migración
// asignacion_directa_y_jerarquia reemplazó equipos/cartera manual por
// jerarquia_usuarios + responsables directos por cliente.
//
// Convención del repo (OBLIGATORIA):
//   - Identificadores Prisma en inglés; tablas/columnas físicas en
//     ESPAÑOL snake_case vía @@map / @map.
//   - Todos los modelos usan id numérico autoincremental. Los códigos de
//     negocio (C-1042, INV, IVA...) se conservan como columnas únicas.
//   - FK SUAVES hacia User y Client: solo el id Int mapeado, SIN
//     @relation (relación lógica sin FK física). Así no se agregan
//     relaciones inversas en User/Client.
//   - Coexiste con usuarios.rol:String @default("Consulta") y can()
//     (src/lib/roles.ts). usuarios.rol se reinterpreta como FK
//     LÓGICA a Role.code (mismo valor), sin migrar esa columna todavía.
//
// NOTA sobre la jerarquía: el PDF separa jerarquía organizacional
// de capacidad operativa. Socio/Gerente/Senior tienen rango alto
// pero son de CONSULTA; el Staff es el ÚNICO que escribe pese a su
// rango bajo. Un can() puramente jerárquico NO captura esto: la
// verdad operativa vive en la matriz RolePermission (y, por
// conveniencia, en Role.isOperative). Role.rank se conserva solo
// para alimentar can()/ROLE_RANK durante la transición.
// ============================================================

/// Catálogo de ROLES (los 5 del PDF + roles legado para no dejar
/// usuarios huérfanos). Editable por el Administrador sin desplegar
/// código. `code` es la llave natural en español que vive en
/// usuarios.rol, reinterpretada como FK lógica.
model Role {
  id          Int              @id @default(autoincrement()) @map("id")
  code        String           @unique @map("codigo") // socio | gerente | senior | staff | administrador (+ legado: Consulta/Auditor/Líder)
  name        String           @map("nombre") // etiqueta visible: "Socio", "Senior"...
  description String?          @map("descripcion") // responsabilidad según el PDF
  rank        Int              @default(0) @map("rango") // jerarquía: alimenta ROLE_RANK/can() durante la transición
  isOperative Boolean          @default(false) @map("es_operativo") // true SOLO para Staff (único que escribe/ejecuta)
  isSystem    Boolean          @default(false) @map("es_sistema") // roles base no borrables desde la UI
  active      Boolean          @default(true) @map("activo")
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("creado_en")
  updatedAt   DateTime         @updatedAt @map("actualizado_en")

  @@index([rank])
  @@map("roles")
}

/// Catálogo de PERMISOS atómicos. `code` es la llave canónica
/// "<modulo>:<accion>" usada por los gates en código (p.ej.
/// "conciliaciones:ejecutar", "clientes:configurar"). Las columnas
/// module/action/label permiten al Administrador entender y filtrar
/// la matriz en una futura UI.
model Permission {
  id          Int              @id @default(autoincrement()) @map("id")
  code        String           @unique @map("codigo") // <modulo>:<accion>
  module      String           @map("modulo") // conciliaciones | balance | dian | clientes | usuarios | equipos | auditoria...
  action      String           @map("accion") // ver | crear | editar | eliminar | ejecutar | revisar | supervisar | asignar | configurar
  label       String           @map("etiqueta") // texto legible para la matriz del Administrador
  description String?          @map("descripcion")
  active      Boolean          @default(true) @map("activo")
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("creado_en")

  @@unique([module, action])
  @@index([module])
  @@map("permisos")
}

/// MATRIZ rol × permiso (concesión). La tabla que el Administrador
/// edita para conceder/revocar permisos sin desplegar código.
/// Fila presente = permiso concedido (sin flag de denegación).
model RolePermission {
  id           Int        @id @default(autoincrement()) @map("id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       Int        @map("rol_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId Int        @map("permiso_id")
  createdAt    DateTime   @default(now()) @map("creado_en")

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("roles_permisos")
}

/// JERARQUÍA organizacional usuario↔usuario (muchos a muchos).
/// Aristas entre roles ADYACENTES: Socio→Gerente, Gerente→Senior,
/// Senior→Staff. Un staff puede reportar a varios seniors, un senior
/// a varios gerentes, etc. La adyacencia de roles se valida en la
/// server action (src/app/actions/users.ts), no en BD.
/// superiorId y subordinateId son FK SUAVES a User.id (sin @relation);
/// la limpieza al borrar usuarios es manual (deleteUser).
model UserHierarchy {
  id            Int      @id @default(autoincrement()) @map("id")
  superiorId    Int      @map("superior_id") // FK lógica a User.id
  subordinateId Int      @map("subordinado_id") // FK lógica a User.id
  createdAt     DateTime @default(now()) @map("creado_en")

  @@unique([superiorId, subordinateId])
  @@index([subordinateId])
  @@map("jerarquia_usuarios")
}

/// RESPONSABLES del cliente — asignación DIRECTA (sin equipos), hecha
/// al crear/editar el cliente. Un cliente admite UNO O VARIOS staff y
/// EXACTAMENTE un senior y un gerente:
///   staff   → ejecuta la auditoría (readScope + writeScope) · uno o varios
///   senior  → revisa               (readScope) · uno
///   gerente → valida               (readScope) · uno
/// El Socio NO se asigna: deriva LECTURA por jerarquía
/// (jerarquia_usuarios) sobre los clientes donde sus gerentes
/// subordinados tengan funcion="gerente" vigente.
///
/// Vigencia temporal: validFrom/validUntil delimitan la ventana en la
/// que la asignación AUTORIZA (se filtra por fecha al leer en
/// getAsignacionesUsuario, sin jobs).
///
/// clientId, userId y assignedById son FK SUAVES numéricas (a
/// Client.id y User.id).
model ClientAssignment {
  id           Int       @id @default(autoincrement()) @map("id")
  clientId     Int       @map("cliente_id") // FK lógica a Client.id
  userId       Int       @map("usuario_id") // responsable (FK lógica a User.id)
  role         String    @map("funcion") // staff | senior | gerente
  readScope    Boolean   @default(true) @map("alcance_lectura") // ve este cliente
  writeScope   Boolean   @default(false) @map("alcance_escritura") // escribe/ejecuta (solo staff)
  assignedById Int?      @map("asignado_por_id") // quién asignó (FK lógica a User.id)
  active       Boolean   @default(true) @map("activo")
  validFrom    DateTime  @default(now()) @map("vigente_desde") // inicio de vigencia
  validUntil   DateTime? @map("vigente_hasta") // fin de vigencia; null = permanente
  reason       String?   @map("motivo") // p.ej. "asignación temporal"
  createdAt    DateTime  @default(now()) @map("creado_en")
  updatedAt    DateTime  @updatedAt @map("actualizado_en")

  // (cliente, función, usuario): un cliente admite VARIOS staff distintos,
  // sin poder duplicar a la misma persona en la misma función. La regla de
  // "un solo senior y un solo gerente" se garantiza en la Server Action.
  @@unique([clientId, role, userId])
  @@index([clientId])
  @@index([userId, active, validUntil])
  @@map("asignaciones_cliente")
}

// ===== Clientes y módulos =====
model Client {
  id              Int              @id @default(autoincrement()) @map("id")
  code            String           @unique @map("codigo") // p.ej. C-1042
  name            String           @map("nombre")
  nit             String           @map("nit")
  tipo            String           @default("C") @map("tipo_cliente") // clasificación A | B | C
  erp             Erp?             @relation(fields: [erpId], references: [id], onDelete: Restrict)
  erpId           Int?             @map("erp_id") // FK al catálogo erps (opcional: se exige al INICIAR una operación, no al cargar)
  sector          Sector?          @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  sectorId        Int?             @map("sector_id") // FK al catálogo sectores (opcional: hay clientes sin sector)
  socioId         Int?             @map("socio_id") // socio responsable (FK lógica a User.id, informativo)
  modules         ClientModule[]
  dianForms       ClientDianForm[]
  reconciliations Reconciliation[]
  createdAt       DateTime         @default(now()) @map("creado_en")

  @@index([socioId])
  @@index([erpId])
  @@index([sectorId])
  @@map("clientes")
}

// ===== Catálogos maestros: ERP y Sector (Config · Clientes) =====
/// Catálogo de sistemas contables/ERP que usan los clientes (SIESA, SIIGO,
/// SAP…). `code` es la forma canónica en MAYÚSCULAS sin acentos; `name` la
/// etiqueta visible. Antes era texto libre en clientes.erp.
model Erp {
  id        Int      @id @default(autoincrement()) @map("id")
  code      String   @unique @map("codigo") // forma canónica: SIESA, SAP, SIIGO, OFIMATICA...
  name      String   @map("nombre") // etiqueta visible
  active    Boolean  @default(true) @map("activo")
  order     Int      @default(0) @map("orden")
  clients   Client[]
  createdAt DateTime @default(now()) @map("creado_en")

  @@map("erps")
}

/// Catálogo de sectores económicos del cliente. El origen trae "N-Nombre"
/// (p.ej. "15-ESAL"): `code` guarda el número ("15") y `name` la etiqueta
/// ("ESAL"). Antes era texto libre en clientes.sector.
model Sector {
  id        Int      @id @default(autoincrement()) @map("id")
  code      String   @unique @map("codigo") // número del sector: "5", "15"...
  name      String   @map("nombre") // etiqueta: "Comercio y Distribución", "ESAL"...
  active    Boolean  @default(true) @map("activo")
  order     Int      @default(0) @map("orden")
  clients   Client[]
  createdAt DateTime @default(now()) @map("creado_en")

  @@map("sectores")
}

model Module {
  id      Int            @id @default(autoincrement()) @map("id")
  code    String         @unique @map("codigo") // INV, CAR, NOM...
  name    String         @map("nombre")
  icon    String         @map("icono")
  clients ClientModule[]
  fields  ModuleField[]

  @@map("modulos")
}

// ===== Campos estándar por módulo (Config · Módulos y campos) =====
model ModuleField {
  id       Int     @id @default(autoincrement()) @map("id")
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId Int     @map("modulo_id")
  key      String  @map("clave") // clave técnica: cuenta, codigo_item...
  label    String  @map("etiqueta")
  type     String  @map("tipo") // string | number | date
  required Boolean @default(false) @map("requerido")
  hint     String? @map("ayuda")
  order    Int     @default(0) @map("orden")

  @@unique([moduleId, key])
  @@map("campos_modulo")
}

model ClientModule {
  id       Int    @id @default(autoincrement()) @map("id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int    @map("cliente_id")
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId Int    @map("modulo_id")
  status   String @map("estado") // configured | pending

  @@unique([clientId, moduleId])
  @@map("modulos_cliente")
}

// ===== Formularios DIAN activados por cliente (Config · Clientes) =====
/// Qué formatos DIAN (IVA F-300, Retención F-350, ICA F-CHIP…) aplican a cada
/// cliente. Se eligen en la sección "Módulos del cliente" al crear/editar el
/// cliente: activar DIAN equivale a tener al menos un formato seleccionado.
model ClientDianForm {
  id        Int      @id @default(autoincrement()) @map("id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  Int      @map("cliente_id")
  form      DianForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    Int      @map("formulario_id")
  createdAt DateTime @default(now()) @map("creado_en")

  @@unique([clientId, formId])
  @@map("formularios_dian_cliente")
}

// ===== Superadministración · publicación visual de módulos =====
/// Catálogo de módulos funcionales de la plataforma. Controla si un
/// módulo se publica para usuarios NO superadministradores. No concede permisos:
/// la autorización final sigue siendo la matriz RolePermission.
model PlatformModule {
  id                         Int      @id @default(autoincrement()) @map("id")
  key                        String   @unique @map("clave") // balance | dian | conciliaciones...
  label                      String   @map("etiqueta")
  description                String?  @map("descripcion")
  group                      String   @map("grupo") // Trabajo | Configuración
  icon                       String   @map("icono")
  order                      Int      @default(0) @map("orden")
  enabledForNonAdmins        Boolean  @default(true) @map("habilitado_no_administradores")
  configurableForNonAdmins   Boolean  @default(true) @map("bloqueable_no_administradores")
  createdAt                  DateTime @default(now()) @map("creado_en")
  updatedAt                  DateTime @updatedAt @map("actualizado_en")

  @@index([group, order])
  @@map("modulos_plataforma")
}

// ===== Conciliaciones =====
model Reconciliation {
  id           Int                     @id @default(autoincrement()) @map("id")
  code         String                  @unique @map("codigo") // REC-2026-0418
  client       Client?                 @relation(fields: [clientId], references: [id])
  clientId     Int?                    @map("cliente_id")
  clientName   String                  @map("nombre_cliente")
  module       String                  @map("modulo")
  period       String                  @map("periodo")
  erp          String                  @map("erp")
  status       String                  @map("estado") // OK | DIFF | REVIEW
  diff         String                  @map("diferencia")
  items        Int                     @default(0) @map("items")
  date         String                  @map("fecha")
  owner        String                  @map("responsable")
  cutoff       String?                 @map("corte")
  runAt        String?                 @map("ejecutado_en")
  runBy        String?                 @map("ejecutado_por")
  lastActivity String?                 @map("ultima_actividad")
  materiality  Int                     @default(2000000) @map("materialidad")
  rows         ReconciliationRow[]
  comments     ReconciliationComment[]
  createdAt    DateTime                @default(now()) @map("creado_en")

  @@index([createdAt])
  @@map("conciliaciones")
}

model ReconciliationRow {
  id               Int            @id @default(autoincrement()) @map("id")
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  reconciliationId Int            @map("conciliacion_id")
  cuenta           String         @map("cuenta")
  desc             String         @map("descripcion")
  cont             Int            @map("saldo_contabilidad") // saldo contabilidad
  mod              Int            @map("saldo_modulo") // saldo módulo
  diff             Int            @map("diferencia")
  items            Int            @default(0) @map("items")
  manualStatus     String?        @map("estado_manual") // conciliada | excepcion | ajuste (override del estado por materialidad)
  order            Int            @default(0) @map("orden")

  @@index([reconciliationId])
  @@map("filas_conciliacion")
}

model ReconciliationComment {
  id               Int            @id @default(autoincrement()) @map("id")
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  reconciliationId Int            @map("conciliacion_id")
  cuenta           String         @map("cuenta")
  who              String         @map("autor")
  initials         String         @map("iniciales")
  text             String         @map("texto")
  time             String         @map("hora")
  createdAt        DateTime       @default(now()) @map("creado_en")

  @@map("comentarios_conciliacion")
}

// ===== Notificaciones =====
model Notification {
  id        Int      @id @default(autoincrement()) @map("id")
  kind      String   @map("tipo") // assign | comment | system
  who       String   @map("autor")
  text      String   @map("texto")
  target    String   @map("destino")
  time      String   @map("hora")
  unread    Boolean  @default(true) @map("no_leida")
  createdAt DateTime @default(now()) @map("creado_en")

  @@map("notificaciones")
}

// ===== Conversaciones (comentarios polimórficos + menciones) =====

/// Comentario de una CONVERSACIÓN anclada de forma POLIMÓRFICA a
/// cualquier registro de negocio mediante (entidad_tipo, entidad_id).
/// `entidad_tipo` reutiliza los códigos de módulo del RBAC
/// (conciliaciones | dian | clientes | balance…), de
/// modo que el mismo código identifica el módulo del permiso, el ítem
/// de navegación y la entidad conversable. `ancla` ubica el comentario
/// dentro del registro cuando aplica (p.ej. la cuenta en una
/// conciliación o el renglón en un formulario DIAN).
model Comment {
  id         Int              @id @default(autoincrement()) @map("id")
  entityType String           @map("entidad_tipo")
  entityId   Int              @map("entidad_id")
  anchor     String?          @map("ancla")
  author     User             @relation("ComentariosAutor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId   Int              @map("autor_id")
  body       String           @map("texto")
  parent     Comment?         @relation("ComentarioHilo", fields: [parentId], references: [id], onDelete: Cascade)
  parentId   Int?             @map("comentario_padre_id")
  replies    Comment[]        @relation("ComentarioHilo")
  isAI       Boolean          @default(false) @map("es_ia")
  editedAt   DateTime?        @map("editado_en")
  createdAt  DateTime         @default(now()) @map("creado_en")
  mentions   CommentMention[]

  @@index([entityType, entityId])
  @@index([authorId])
  @@map("comentarios")
}

/// Mención (@usuario) dentro de un comentario. Tabla propia para poder
/// consultar "mis menciones", marcarlas leídas y disparar la
/// notificación al usuario arrobado.
model CommentMention {
  id        Int       @id @default(autoincrement()) @map("id")
  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int       @map("comentario_id")
  user      User      @relation("MencionesUsuario", fields: [userId], references: [id], onDelete: Cascade)
  userId    Int       @map("usuario_mencionado_id")
  readAt    DateTime? @map("leido_en")
  createdAt DateTime  @default(now()) @map("creado_en")

  @@unique([commentId, userId])
  @@index([userId])
  @@map("menciones_comentario")
}

// ===== Auditoría =====
model AuditEntry {
  id        Int      @id @default(autoincrement()) @map("id")
  ts        String   @map("marca_tiempo")
  user      String   @map("usuario")
  action    String   @map("accion")
  entity    String   @map("entidad")
  detail    String   @map("detalle")
  ip        String?  @map("ip")
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([createdAt])
  @@map("registros_auditoria")
}

// ===== Plan de cuentas estándar (Balance) =====
model StandardAccount {
  id                  Int     @id @default(autoincrement()) @map("id")
  code                String  @unique @map("codigo")
  name                String  @map("nombre")
  level               Int     @map("nivel")
  nature              String  @map("naturaleza") // D | C
  parent              String? @map("padre")
  critical            Boolean @default(false) @map("critica")
  russellAccount      String? @map("cuenta_russell")
  categoryType        String? @map("tipo_rubro")
  includes            String? @map("incluye")
  excludes            String? @map("no_incluye")
  possibleAccounts    String? @map("cuentas_posibles")
  supportingDocuments String? @map("soportes_terceros")
  controlSupports     String? @map("soportes_control")
  mappingNotes        String? @map("observaciones_homologacion")

  @@map("cuentas_estandar")
}

// ===== Subgrupos del plan estándar (nivel 4) =====
// Catálogo de subgrupos de 4 dígitos del plan Russell: aporta el NOMBRE de los
// niveles 4 y 2 para la vista jerárquica del balance (clase 2 → subgrupo 4 →
// cuenta estándar 6 → cuenta cliente 8). El enlace con `cuentas_estandar` es por
// prefijo del código (no hay FK física). Se carga desde
// `prisma/data/subgrupos-russell.json` con `npm run db:load:subgrupos`.
model SubgrupoEstandar {
  id          Int    @id @default(autoincrement()) @map("id")
  codigo      String @unique @map("codigo") // 4 dígitos (p. ej. 1105)
  nombre      String @map("nombre") // nombre del subgrupo (p. ej. Caja)
  grupo       String @map("grupo") // 2 dígitos (p. ej. 11)
  nombreGrupo String @map("nombre_grupo") // nombre del grupo (p. ej. Disponible)
  naturaleza  String @map("naturaleza") // D | C

  @@index([grupo])
  @@map("subgrupos_estandar")
}

// ===== Bitácora del plan de cuentas estándar =====
// Registro DEDICADO de todos los movimientos (crear/editar/eliminar) sobre las
// cuentas estándar de Russell, para evidenciar la trazabilidad completa de la
// parametrización del plan. Solo el Administrador opera esa tabla y cada cambio
// deja una fila aquí (además del registro global en `AuditEntry`).
// FK LÓGICAS (solo Int, sin @relation) hacia User y StandardAccount: la
// bitácora se CONSERVA aunque luego se borre la cuenta o el usuario; `code`
// preserva la referencia legible cuando `accountId` ya no existe.
model StandardAccountLog {
  id        Int      @id @default(autoincrement()) @map("id")
  accountId Int?     @map("cuenta_id") // id de la cuenta afectada (null tras borrado físico)
  code      String   @map("codigo") // código del sistema afectado (preserva referencia)
  action    String   @map("accion") // CREÓ | EDITÓ | ELIMINÓ
  user      String   @map("usuario") // nombre del actor
  userId    Int?     @map("usuario_id") // FK lógica al User
  detail    String   @map("detalle") // resumen legible del cambio
  before    Json?    @map("antes") // snapshot previo (campos)
  after     Json?    @map("despues") // snapshot nuevo (campos)
  ip        String?  @map("ip")
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([accountId])
  @@index([createdAt])
  @@map("bitacora_cuentas_estandar")
}

// ===== Balance de comprobación =====
// DEPRECADO: modelo legado basado en JSON (`desglose`, `sumas`, etc.). Sustituido
// por el modelo normalizado `BalancePruebaEncabezado` + `BalancePruebaDetalle`.
// Se conserva la tabla (vacía) por compatibilidad; ya no se lee ni escribe.
model Balance {
  id              Int      @id @default(autoincrement()) @map("id")
  clientName      String   @map("nombre_cliente")
  clientNit       String?  @map("nit_cliente")
  period          String   @map("periodo")
  version         String   @map("version")
  isOfficial      Boolean  @default(false) @map("es_oficial")
  isFrozen        Boolean  @default(false) @map("esta_congelado")
  status          String   @default("Única") @map("estado")
  complete        Int      @default(100) @map("completitud")
  sums            Json?    @map("sumas") // activo, pasivo, patrimonio, ingresos, gastos, costos, utilidad
  validations     Json?    @map("validaciones") // reglas de validación
  breakdown       Json?    @map("desglose") // desglose por nivel 2 con items
  meta            Json?    @map("metadatos") // metadatos del cargue (file, rows, accounts...)
  versionHistory  Json?    @map("historial_versiones") // historial de versiones (v3/v2/v1) con metadatos
  diff            Json?    @map("comparativo") // comparativo de la versión oficial vs. la anterior
  auditLog        Json?    @map("bitacora") // bitácora de cargues/congelados por cliente
  incomeStatement Json?    @map("estado_resultado") // líneas del estado de resultado (concepto, 2025, 2024, presupuesto)
  lastUpload      String?  @map("ultima_carga") // fecha-hora de la última carga (display)
  createdAt       DateTime @default(now()) @map("creado_en")

  @@unique([clientName, period, version])
  @@map("balances")
}

// ===== Balance de prueba normalizado (encabezado + detalle) =====
// Modelo relacional del balance de comprobación del cliente. El ENCABEZADO es un
// cargue por (cliente, período, versión); el DETALLE es una fila por cuenta, con
// la cuenta desagregada por nivel PUC (2/4/6/8) y los montos como columnas reales
// (`saldo_inicial`, `debitos`, `creditos`, `saldo_final`) consultables vía SQL.
// Los agregados (sumas, validaciones, desglose, comparativo) se RECALCULAN desde
// el detalle al leer (ver `src/lib/balance/calcular.ts`), no se persisten.
model BalancePruebaEncabezado {
  id              Int      @id @default(autoincrement()) @map("id")
  // FK LÓGICA a Client (solo Int, sin @relation): convención del proyecto para
  // FKs suaves hacia Client/User. `nombreCliente`/`nit` quedan denormalizados
  // para listar sin join.
  clienteId       Int      @map("cliente_id")
  nombreCliente   String   @map("nombre_cliente")
  nit             String?  @map("nit")
  periodo         String   @map("periodo") // display, p. ej. "Enero 2026"
  periodoInicio   DateTime @map("periodo_inicio") @db.Date
  periodoFin      DateTime @map("periodo_fin") @db.Date
  centroOperativo String?  @map("centro_operativo")
  // Versionado (un oficial por cliente/período; congelado bloquea edición).
  version         String   @map("version")
  esOficial       Boolean  @default(false) @map("es_oficial")
  estaCongelado   Boolean  @default(false) @map("esta_congelado")
  estado          String   @default("Única") @map("estado")
  completitud     Int      @default(100) @map("completitud")
  // Resumen del cargue (para listados, ficha de versión y bitácora sin recalcular).
  archivo         String?  @map("archivo")
  tamanoArchivo   String?  @map("tamano_archivo")
  cargadoPor      String?  @map("cargado_por")
  rolCarga        String?  @map("rol_carga")
  cuadrado        Boolean  @default(true) @map("cuadrado")
  nota            String?  @map("nota")
  sumaActivo      Decimal  @default(0) @map("suma_activo") @db.Decimal(18, 2)
  filasTotales    Int      @default(0) @map("filas_totales")
  mapeadas        Int      @default(0) @map("mapeadas")
  sinMapear       Int      @default(0) @map("sin_mapear")
  criticas        Int      @default(0) @map("criticas")
  cambios         Int      @default(0) @map("cambios")
  // Metadatos del ETL.
  estandar          String?   @map("estandar")
  convencionCredito String?   @map("convencion_credito")
  filasLeidas       Int?      @map("filas_leidas")
  filasExcluidas    Int?      @map("filas_excluidas")
  filasDescuadre    Int?      @map("filas_descuadre")
  congeladoPor      String?   @map("congelado_por")
  congeladoEn       DateTime? @map("congelado_en")
  ultimaCarga       String?   @map("ultima_carga") // sello legible del último cargue
  creadoEn          DateTime  @default(now()) @map("creado_en")

  detalles BalancePruebaDetalle[]

  @@unique([clienteId, periodo, version])
  @@index([clienteId, periodo])
  @@index([nombreCliente])
  @@map("balance_prueba_encabezado")
}

model BalancePruebaDetalle {
  id           Int                     @id @default(autoincrement()) @map("id")
  encabezadoId Int                     @map("encabezado_id")
  encabezado   BalancePruebaEncabezado @relation(fields: [encabezadoId], references: [id], onDelete: Cascade)
  // Cuenta desagregada por nivel PUC (prefijos del código imputable).
  cuenta2      String                  @map("cuenta_2") // 11
  cuenta4      String                  @map("cuenta_4") // 1110
  cuenta6      String                  @map("cuenta_6") // 111005
  cuenta8      String                  @map("cuenta_8") // 11100501 (código imputable completo)
  nombreCuenta String                  @map("nombre_cuenta")
  // Mapeo al plan estándar Russell (cuenta de 6 dígitos) + % de coincidencia.
  cuenta6Russell String?               @map("cuenta_6_russell")
  coincidencia   Decimal?              @map("porcentaje_coincidencia") @db.Decimal(5, 2)
  // Montos del balance de comprobación (firmados: débito +, crédito −).
  saldoInicial Decimal                 @default(0) @map("saldo_inicial") @db.Decimal(18, 2)
  debitos      Decimal                 @default(0) @map("debitos") @db.Decimal(18, 2)
  creditos     Decimal                 @default(0) @map("creditos") @db.Decimal(18, 2)
  saldoFinal   Decimal                 @default(0) @map("saldo_final") @db.Decimal(18, 2)
  creadoEn     DateTime                @default(now()) @map("creado_en") // TS CREA
  editadoEn    DateTime                @updatedAt @map("editado_en") // TS EDICIÓN

  @@index([encabezadoId])
  @@index([cuenta6])
  @@index([cuenta6Russell])
  @@map("balance_prueba_detalle")
}

// ===== Configuración de mapeo por cliente (memoria entre períodos) =====
// Recuerda a qué cuenta estándar Russell se mapea cada cuenta de 6 dígitos del
// cliente, para que la parametrización se haga UNA sola vez: al importar otro
// período del mismo cliente, este mapeo se aplica primero (prioridad sobre la
// cascada exacto/descripción/IA). `origen=manual` (asignación a mano) no se pisa
// por mapeos automáticos. FK suave a Client (Int, sin @relation).
model MapeoBalanceCliente {
  id             Int      @id @default(autoincrement()) @map("id")
  clienteId      Int      @map("cliente_id")
  cuenta6        String   @map("cuenta_6") // código del cliente (6 dígitos)
  cuenta6Russell String   @map("cuenta_6_russell") // cuenta estándar asignada
  coincidencia   Decimal? @map("porcentaje_coincidencia") @db.Decimal(5, 2)
  origen         String   @default("automatico") @map("origen") // manual | automatico
  actualizadoPor String?  @map("actualizado_por")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")

  @@unique([clienteId, cuenta6])
  @@index([clienteId])
  @@map("mapeo_balance_cliente")
}

// ===== Impuestos · DIAN =====
model DianForm {
  id          Int           @id @default(autoincrement()) @map("id")
  key         String        @unique @map("clave") // IVA, RETEFUENTE...
  name        String        @map("nombre")
  code        String        @map("codigo") // F-300
  periodicity String        @map("periodicidad")
  icon        String        @map("icono")
  objective   String?       @map("objetivo")
  conclusion  String?       @map("conclusion")
  periods     DianPeriod[]
  sections    DianSection[]
  mappings    DianMapping[]
  comments    DianComment[]
  clientForms ClientDianForm[]

  @@map("formularios_dian")
}

model DianPeriod {
  id        Int      @id @default(autoincrement()) @map("id")
  periodKey String   @map("clave_periodo") // 2026-B5
  label     String   @map("etiqueta")
  status    String   @map("estado") // OK | DIFF | PEND
  filed     String?  @map("presentado")
  form      DianForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    Int      @map("formulario_id")

  @@unique([formId, periodKey])
  @@map("periodos_dian")
}

model DianSection {
  id     Int        @id @default(autoincrement()) @map("id")
  key    String     @unique @map("clave")
  form   DianForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId Int        @map("formulario_id")
  title  String     @map("titulo")
  side   String     @default("L") @map("lado") // L | R (lado visual)
  note   String?    @map("nota")
  order  Int        @default(0) @map("orden")
  lines  DianLine[]

  @@map("secciones_dian")
}

model DianLine {
  id        Int         @id @default(autoincrement()) @map("id")
  section   DianSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId Int         @map("seccion_id")
  k         String      @map("casilla") // casilla: GEN-19, DES-CBG...
  label     String      @map("etiqueta")
  decl      Float       @default(0) @map("declarado")
  cont      Float       @default(0) @map("contabilidad")
  diff      Float       @default(0) @map("diferencia")
  order     Int         @default(0) @map("orden")

  @@map("renglones_dian")
}

model DianMapping {
  id      Int      @id @default(autoincrement()) @map("id")
  form    DianForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId  Int      @map("formulario_id")
  lineKey String   @map("clave_renglon") // k del renglón
  account String   @map("cuenta")
  desc    String   @map("descripcion")
  sign    String   @map("signo") // + | -
  order   Int      @default(0) @map("orden")

  @@map("mapeos_dian")
}

model DianComment {
  id        Int      @id @default(autoincrement()) @map("id")
  form      DianForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    Int      @map("formulario_id")
  lineKey   String   @map("clave_renglon")
  who       String   @map("autor")
  initials  String   @map("iniciales")
  text      String   @map("texto")
  time      String   @map("hora")
  isAI      Boolean  @default(false) @map("es_ia")
  createdAt DateTime @default(now()) @map("creado_en")

  @@map("comentarios_dian")
}

// ===== Mapeo cuenta-cliente → Russell (Balance · Mapeo plan estándar) =====
model ClientAccount {
  id              Int            @id @default(autoincrement()) @map("id")
  clientName      String         @map("nombre_cliente")
  code            String         @map("codigo")
  level           Int            @map("nivel") // 4 | 6 | 8
  name            String         @map("nombre")
  russellOption   RussellOption? @relation(fields: [russellOptionId], references: [id], onDelete: SetNull)
  russellOptionId Int?           @map("opcion_russell_id")
  order           Int            @default(0) @map("orden")

  @@unique([clientName, code])
  @@map("cuentas_cliente")
}

model RussellOption {
  id       Int             @id @default(autoincrement()) @map("id")
  code     String          @unique @map("codigo") // 1105, 1110, 41...
  name     String          @map("nombre")
  module   String?         @map("modulo") // Caja, Bancos, Cartera, DIAN... (null = no participa en conciliaciones)
  accounts ClientAccount[]

  @@map("opciones_russell")
}
